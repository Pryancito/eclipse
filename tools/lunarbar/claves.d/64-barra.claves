# Eclipse OS: la barra superior (lunarbar). Todo va a
# /etc/eclipse/entorno con eclipse-entorno, que reinicia la barra. Un
# módulo apagado deja su sitio a los demás (tools/lunarbar/src/barra.rs).
# Formato: tools/lunarbar/src/claves.rs.

[grupo:barra]
es = Barra superior
en = Top bar

[barra.alto]
grupo   = barra
fichero = /etc/eclipse/entorno
clave   = LUNARBAR_HEIGHT
tipo    = elegir
valores = auto:Automática 28 32 36 40 44 48 56 64
valores.en = auto:Automatic
defecto = auto
aplicar = /usr/local/bin/eclipse-entorno LUNARBAR_HEIGHT {}
es      = Altura de la barra
en      = Bar height
ayuda   = Automática sigue al aspecto; la barra se reinicia
ayuda.en = Automatic follows the look; the bar restarts

[barra.escritorios]
grupo   = barra
fichero = /etc/eclipse/entorno
clave   = LUNARBAR_ESCRITORIOS
tipo    = si-no
valores = si no
defecto = si
aplicar = /usr/local/bin/eclipse-entorno LUNARBAR_ESCRITORIOS {}
es      = Escritorios
en      = Desktops
ayuda   = Los botones 01 02 03 04 (aspecto tecno)
ayuda.en = The 01 02 03 04 chips (tecno look)

[barra.titulo]
grupo   = barra
fichero = /etc/eclipse/entorno
clave   = LUNARBAR_TITULO
tipo    = si-no
valores = si no
defecto = si
aplicar = /usr/local/bin/eclipse-entorno LUNARBAR_TITULO {}
es      = Título de la ventana
en      = Window title
ayuda   = La ventana activa, en el centro (aspecto tecno)
ayuda.en = The focused window, centred (tecno look)

[barra.cpu]
grupo   = barra
fichero = /etc/eclipse/entorno
