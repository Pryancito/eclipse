# /etc/hunter/feeds — where `hunterctl update-signatures` downloads from.
#
#   <format> <name> <url>
#
# format `sha256`: one SHA-256 per line (first field; `#` comments), every hash
#                  becomes `hash:<sha256>:<name>`.
# format `sigs`:   hunter's own signature lines (see /etc/hunter/signatures).
#
# Each feed lands in /etc/hunter/signatures.d/<name>, replacing the previous
# download only if the new one is non-empty and hunter accepted all of it.
# To update every 6 hours with busybox crond:
#   0 */6 * * * /sbin/hunterctl update-signatures
#
# abuse.ch MalwareBazaar: SHA-256 of malware samples submitted in the last 48
# hours (free, no key needed for this export).
sha256 MalwareBazaar.Recent https://bazaar.abuse.ch/export/txt/sha256/recent/
