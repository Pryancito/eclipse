        # is its next slot, not this minute. And a clock that went back
        # (an RTC reset, before NTP) must not hold a job off for days.
        if [ -z "$last" ] || [ "$last" -gt $((now + 86400)) ]; then
            echo "$now" > "$SCANS/$job.last"
            continue
        fi
        next=$(next_slot "$last" "$1" "$2") || { echo "hunterctl: $job: bad schedule" >&2; continue; }
        if [ "$now" -ge "$next" ]; then
            run_job "$job" scheduled || rc=1
        fi
    done
    exit "$rc"
    ;;
scan-history)
    n=${1:-20}
    case "$n" in ''|*[!0-9]*) usage 1 ;; esac
    [ -r "$SCANS/history" ] || { echo "hunterctl: no scheduled scan has run yet"; exit 0; }
    printf 'date\tjob\ttrigger\tseconds\tfiles\tinfected\tquarantined\tstatus\treport\n'
    tail -n "$n" "$SCANS/history"
    ;;
scheduler)
    [ "$(id -u)" = 0 ] || die "must be root"
    # In the foreground, for eclipse-init to supervise. A failed scan is
    # in the history; the loop carries on.
    while :; do
        "$0" run-scheduled --due
        sleep 60
    done
    ;;
net)
    [ -r "$NET" ] || die "$NET not found: this kernel's hunter has no network monitor"
    cat "$NET"
    ;;
expect-port|forget-port)
    [ $# -ge 2 ] && [ $# -le 3 ] || usage 1
    rule="$1 $2${3:+ $3}"
    # Live first: the kernel parses it, so a typo never reaches the file.
    send "${cmd%-port} $rule" "$NET"
    mkdir -p "${PORTS%/*}"
    touch "$PORTS"
    tmp=$(mktemp) || die "mktemp failed"
    grep -vxF -- "expect $rule" "$PORTS" > "$tmp"
    [ "$cmd" = expect-port ] && printf 'expect %s\n' "$rule" >> "$tmp"
    cat "$tmp" > "$PORTS"
    rm -f "$tmp"
    echo "hunterctl: ${cmd%-port} $rule (saved in $PORTS)"
    ;;
feed-rollback)
    [ $# -eq 1 ] || [ $# -eq 2 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    [ -w "$FEEDPROC" ] || die "$FEEDPROC not found: this kernel cannot verify feeds"
    valid_feed_name "$1" || die "bad feed name '$1'"
    dir="$HISTORY/$1"
    [ -d "$dir" ] || die "no saved versions of $1"
    if [ $# -eq 2 ]; then
        ver=$2
    else
        cur=$(cat "$dir/current" 2>/dev/null || echo 0)
        ver=$(versions "$1" | awk -v c="$cur" '$1 < c { v = $1 } END { print v }')
        [ -n "$ver" ] || die "no saved version of $1 older than $cur"
    fi
    case "$ver" in ''|*[!0-9]*) die "a version is a number, see '$0 feeds'" ;; esac
    [ -f "$dir/$ver" ] || die "no saved version $ver of $1 (see '$0 feeds')"
    stage="$SIGDIR/.$1.new"
    rm -f "$stage" "$stage.sig"
    cp "$dir/$ver" "$stage" || die "cannot write $SIGDIR"
    [ -f "$dir/$ver.sig" ] && { cp "$dir/$ver.sig" "$stage.sig" || die "cannot write $SIGDIR"; }
    install_feed rollback "$1" "$stage" "$ver"
    ;;
daemon)
    # hunterd. eclipse-init starts it (as /usr/local/bin/eclipse-hunterd) and
    # restarts it if it dies; the cursor on disk makes a restart pick up
    # where the last pass stopped. TERM (shutdown) gets one last pass.
    [ "$(id -u)" = 0 ] || [ -n "$R" ] || die "must be root"
    interval=${1:-5}
    case "$interval" in ''|*[!0-9]*|0) usage 1 ;; esac
    # The trap only raises a flag, and the loop makes the last pass.
    stop=0
    trap 'stop=1' TERM INT HUP
    while [ "$stop" = 0 ]; do
        persist || echo "hunterctl: could not save hunter's state" >&2
        [ "$stop" = 0 ] || break
        # In the background and waited for, so a TERM ends the wait now and
        # not when the sleep does.
        sleep "$interval" &
        wait $!
    done
    kill $! 2>/dev/null
    persist
    ;;
persist)
    [ "$(id -u)" = 0 ] || [ -n "$R" ] || die "must be root"
    persist || die "could not save hunter's state"
    ;;
save-learned)
    [ "$(id -u)" = 0 ] || die "must be root"
    mkdir -p "${WHITELIST%/*}"
    touch "$WHITELIST"
    tmp=$(mktemp) || die "mktemp failed"
    sed -n '/^learned-programs/,/^$/{/^  /s/^  //p}' "$PROC" > "$tmp"
    added=0
    while IFS= read -r p; do
        if ! grep -qxF -- "$p" "$WHITELIST"; then
            printf '%s\n' "$p" >> "$WHITELIST"
            added=$((added + 1))
        fi
    done < "$tmp"
    rm -f "$tmp"
    echo "hunterctl: $added program(s) added to $WHITELIST"
    ;;
*)
    usage 1
    ;;
esac
