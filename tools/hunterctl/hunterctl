#!/bin/sh
# hunterctl — operator front end for hunter, Eclipse OS's in-kernel security
# subsystem.
#
# Everything it changes goes through one door: a write to /proc/hunter, in
# hunter's control language (see docs/hunter-security.md). The kernel checks
# that the writer is root and applies each write all or nothing, so this
# script holds no policy of its own -- it only spells the directives.
#
#   hunterctl [status]              modes, counters, lists (no event ring)
#   hunterctl events                the full report, event ring included
#   hunterctl mode <domain> <mode>  domain: syscall|wx|exec|anomaly|integrity|av
#                                   mode:   off|report|enforce
#   hunterctl learning <on|off>
#   hunterctl anomaly-detection <on|off>
#   hunterctl privileged-deny <on|off>
#   hunterctl trust <path|dir/>     add to the exec allowlist
#   hunterctl deny <path|dir/>      add to the exec blacklist
#   hunterctl untrusted <dir/>      add a world-writable location
#   hunterctl seal                  one-way: from now on, only tighten
#   hunterctl apply <file>          send a whole policy script (e.g. policy.conf)
#   hunterctl hash <file>...        pin the SHA-256 of programs (live + /etc/hunter/hashes)
#   hunterctl require-hash <on|off> unpinned programs are integrity violations
#   hunterctl verify                check the files on disk against /etc/hunter/hashes
#   hunterctl scan [--quarantine] <path>...
#                                   antivirus scan of files/trees (exit 1 if infected)
#   hunterctl quarantine <file>...  move files into the quarantine and deny their paths
#   hunterctl quarantined           list the quarantine
#   hunterctl restore <sha256>      put a quarantined file back where it was
#   hunterctl update-signatures     download the feeds in /etc/hunter/feeds (signed
#                                   ones are verified by the kernel before use)
#   hunterctl feeds                 installed feeds, trusted keys, saved versions
#   hunterctl feed-rollback <feed> [<version>]
#                                   go back to a saved version (default: the one
#                                   before the installed one)
#   hunterctl trust-key <name> <hex>
#                                   trust an Ed25519 feed key (live + /etc/hunter/keys)
#   hunterctl require-signed-feeds <on|off>
#                                   refuse feeds without a valid signature
#   hunterctl lockdown              enforce exec + integrity + av, learning off, seal
#   hunterctl save-learned          append learned programs to the whitelist

PROC=/proc/hunter
WHITELIST=/etc/hunter/whitelist
HASHES=/etc/hunter/hashes
SCAN=/proc/hunter_scan
QDIR=/var/lib/hunter/quarantine
FEEDS=/etc/hunter/feeds
SIGDIR=/etc/hunter/signatures.d
FEEDPROC=/proc/hunter_feed
KEYS=/etc/hunter/keys
# Every feed version that was installed, by version (a signed feed's serial,
# an unsigned one's UTC download time), for feed-rollback.
HISTORY=/var/lib/hunter/feeds
KEEP=5
# Paths per write to /proc/hunter_scan: each batch is scanned before the
# write returns, and 256 paths stay well under the 1 MiB a write may carry.
BATCH=256
TAB=$(printf '\t')

die() {
    echo "hunterctl: $*" >&2
    exit 1
}

usage() {
    sed -n '/^#   hunterctl \[status\]/,/^#   hunterctl save-learned/p' "$0" | sed 's/^#//'
    exit "${1:-0}"
}

# One write(2) per script: the kernel takes each write as a whole script, all
# or nothing. The script goes through a regular file and a single dd block
# larger than anything hunter accepts, because printf through stdio, or dd
# reading a pipe, could hand a long script over in two pieces -- and two
# halves are two different scripts.
send() {
    [ "$(id -u)" = 0 ] || die "must be root"
    msg=$(mktemp) || die "mktemp failed"
    printf '%s\n' "$1" > "$msg"
    if dd if="$msg" of="$PROC" bs=1048576 count=1 2>/dev/null; then
        rm -f "$msg"
    else
        rm -f "$msg"
        die "hunter rejected the script; nothing was applied (see '$0 events')"
    fi
}

download() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --max-time 300 -o "$2" "$1"
    else
        wget -q -T 300 -O "$2" "$1"
    fi
}

# The names the kernel takes for a feed: a plain file name in signatures.d,
# neither hidden nor a `.sig`.
valid_feed_name() {
    case "$1" in
        ''|.*|*.sig|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
    [ "${#1}" -le 64 ]
}

# The saved versions of a feed, oldest first.
versions() {
    ls "$HISTORY/$1" 2>/dev/null | grep -E '^[0-9]+$' | sort -n
}

# install_feed <install|rollback> <name> <staged file> [<version>]: asks the kernel to
# verify the staged feed (and `<staged file>.sig` when there is one) and load
# it; only once it said yes is the feed moved into signatures.d, where the
# next boot finds it, and (a new version) saved for feed-rollback.
install_feed() {
    how=$1 name=$2 stage=$3
    if [ -f "$stage.sig" ]; then
        req="$how $name $stage $stage.sig"
        ver=$(sed -n 's/^serial //p' "$stage.sig")
    else
        req="$how $name $stage"
        ver=$(date -u +%Y%m%d%H%M%S)
    fi
    if ! printf '%s\n' "$req" > "$FEEDPROC" 2>/dev/null; then
        rm -f "$stage" "$stage.sig"
        echo "hunterctl: $(sed -n 's/^last: //p' "$FEEDPROC")" >&2
        return 1
    fi
    last=$(sed -n 's/^last: //p' "$FEEDPROC")
    case "$last" in
        *unchanged)
            rm -f "$stage" "$stage.sig"
            echo "hunterctl: $name: already up to date"
            return 0 ;;
    esac
    if [ "$how" = install ]; then
        mkdir -p "$HISTORY/$name" || die "cannot create $HISTORY/$name"
        cp "$stage" "$HISTORY/$name/$ver"
        if [ -f "$stage.sig" ]; then cp "$stage.sig" "$HISTORY/$name/$ver.sig"; else rm -f "$HISTORY/$name/$ver.sig"; fi
        versions "$name" | awk -v k="$KEEP" '{ v[NR] = $1 } END { for (i = 1; i <= NR - k; i++) print v[i] }' \
            | while read -r old; do rm -f "$HISTORY/$name/$old" "$HISTORY/$name/$old.sig"; done
    else
        ver=$4
    fi
    # Signature first, feed second, each renamed into place: a reboot in
    # between finds a pair that does not match and refuses that one feed --
    # loud, and fixed by the next update -- never a feed that was not checked.
    if [ -f "$stage.sig" ]; then
        mv "$stage.sig" "$SIGDIR/$name.sig"
    else
        rm -f "$SIGDIR/$name.sig"
    fi
    mv "$stage" "$SIGDIR/$name"
    echo "$ver" > "$HISTORY/$name/current"
    echo "hunterctl: $last"
}

cmd=${1:-status}
[ $# -gt 0 ] && shift

case "$cmd" in
-h|--help|help) usage 0 ;;
esac

[ -r "$PROC" ] || die "$PROC not found: is this an Eclipse OS kernel with hunter?"

case "$cmd" in
status)
    sed '/^recent events/,$d' "$PROC"
    ;;
events)
    cat "$PROC"
    ;;
mode)
    [ $# -eq 2 ] || usage 1
    send "mode $1 $2"
    ;;
learning|anomaly-detection|privileged-deny|require-hash|require-signed-feeds|trust|deny|untrusted)
    [ $# -eq 1 ] || usage 1
    send "$cmd $1"
    ;;
trust-key)
    [ $# -eq 2 ] || usage 1
    send "feed-key $1 $2"
    # The directive always parses; whether hunter took the key (not sealed,
    # and the name had no other key) is in its list.
    pk=$(printf '%s' "$2" | tr 'A-F' 'a-f')
    grep -qx "key $1 $pk" "$FEEDPROC" \
        || die "hunter refused key $1 (sealed, or $1 already has another key; see '$0 events')"
    touch "$KEYS"
    grep -qx "feed-key $1 $pk" "$KEYS" || printf 'feed-key %s %s\n' "$1" "$pk" >> "$KEYS"
    echo "hunterctl: key $1 trusted (and in $KEYS for the next boot)"
    ;;
seal)
    send "seal"
    ;;
apply)
    [ $# -eq 1 ] || usage 1
    [ -r "$1" ] || die "cannot read $1"
    send "$(cat "$1")"
    ;;
hash)
    [ $# -ge 1 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    # Pinned by the file's real path: the kernel checks a program by its name
    # AND by the path it resolves to, so pinning the target covers every link
    # to it. One script for all of them, so the batch is all or nothing too.
    script=""
    mkdir -p "${HASHES%/*}"
    touch "$HASHES"
    tmp=$(mktemp) || die "mktemp failed"
    trap 'rm -f "$tmp" "$tmp.new"' EXIT
    cp "$HASHES" "$tmp"
    for f in "$@"; do
        real=$(readlink -f -- "$f") || die "cannot resolve $f"
        [ -f "$real" ] || die "not a file: $f"
        sum=$(sha256sum -- "$real" | cut -d' ' -f1) || die "cannot hash $real"
        # Replace an earlier pin of the same file rather than stacking a
        # second, stale line under it.
        # (A sha256sum line is 64 hex digits, two spaces, then the path.)
        awk -v p="$real" 'substr($0, 67) != p' "$tmp" > "$tmp.new"
        printf '%s  %s\n' "$sum" "$real" >> "$tmp.new"
        mv "$tmp.new" "$tmp"
        script="${script}hash $sum  $real
"
    done
    send "$script"
    mv "$tmp" "$HASHES"
    echo "hunterctl: pinned $# program(s); $(grep -c . "$HASHES") in $HASHES"
    ;;
verify)
    [ -r "$HASHES" ] || die "no $HASHES"
    sha256sum -c "$HASHES"
    ;;
lockdown)
    # Exec and integrity. W^X stays where it is because enforcing it breaks
    # every JIT (Firefox, any JS engine), and the anomaly heuristics cost a
    # lock on every syscall; both are a deliberate `mode` away. Whatever was
    # learned or pinned so far stays trusted, so run save-learned (and hash)
    # first. After this an updated binary whose pin no longer matches will
    # not run until reboot: re-pinning is a relaxation, and the seal refuses
    # it.
    send "mode exec enforce
mode integrity enforce
mode av enforce
learning off
seal"
    ;;
scan)
    [ "$(id -u)" = 0 ] || die "must be root"
    quarantine=0
    if [ "${1:-}" = "--quarantine" ]; then
        quarantine=1
        shift
    fi
    [ $# -ge 1 ] || usage 1
    [ -w "$SCAN" ] || die "$SCAN not found: this kernel's hunter has no antivirus"
    list=$(mktemp) && out=$(mktemp) && batch=$(mktemp) || die "mktemp failed"
    trap 'rm -f "$list" "$out" "$batch"' EXIT
    find "$@" -type f > "$list" 2>/dev/null
    total=$(wc -l < "$list")
    i=1
    while [ "$i" -le "$total" ]; do
        sed -n "${i},$((i + BATCH - 1))p" "$list" > "$batch"
        dd if="$batch" of="$SCAN" bs=1048576 count=1 2>/dev/null || die "scan write failed"
        cat "$SCAN" >> "$out"
        i=$((i + BATCH))
    done
    grep -E ' FOUND$|: ERROR ' "$out"
    infected=$(grep -c ' FOUND$' "$out")
    echo "hunterctl: scanned $total file(s), $infected infected"
    if [ "$infected" -gt 0 ] && [ "$quarantine" = 1 ]; then
        sed -n 's/: [^ ]* FOUND$//p' "$out" | while IFS= read -r f; do
            "$0" quarantine "$f"
        done
    fi
    [ "$infected" -eq 0 ]
    ;;
quarantine)
    [ $# -ge 1 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    mkdir -p "$QDIR" && chmod 700 "$QDIR" || die "cannot create $QDIR"
    for f in "$@"; do
        real=$(readlink -f -- "$f") || die "cannot resolve $f"
        [ -f "$real" ] || die "not a file: $f"
        sum=$(sha256sum -- "$real" | cut -d' ' -f1)
        mode=$(stat -c %a -- "$real")
        mv -- "$real" "$QDIR/$sum" || die "cannot move $real"
        chmod 000 "$QDIR/$sum"
        printf '%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$sum" "$mode" "$real" >> "$QDIR/index"
        # A copy dropped at the same path again must not run either. The
        # blacklist lasts until reboot (hunter never forgets a deny).
        send "deny $real"
        echo "hunterctl: quarantined $real ($sum)"
    done
    ;;
quarantined)
    [ -r "$QDIR/index" ] || { echo "hunterctl: quarantine is empty"; exit 0; }
    cat "$QDIR/index"
    ;;
restore)
    [ $# -eq 1 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    line=$(grep -F "$TAB$1$TAB" "$QDIR/index" 2>/dev/null | tail -n 1)
    [ -n "$line" ] && [ -e "$QDIR/$1" ] || die "no quarantined file $1"
    mode=$(printf '%s\n' "$line" | cut -f3)
    dest=$(printf '%s\n' "$line" | cut -f4-)
    [ -e "$dest" ] && die "$dest exists; not overwriting it"
    mv -- "$QDIR/$1" "$dest" && chmod "$mode" "$dest" || die "cannot restore to $dest"
    grep -vF "$TAB$1$TAB" "$QDIR/index" > "$QDIR/index.new"; mv "$QDIR/index.new" "$QDIR/index"
    echo "hunterctl: restored $dest (its path stays denied until reboot)"
    ;;
update-signatures)
    [ "$(id -u)" = 0 ] || die "must be root"
    [ -r "$FEEDS" ] || die "no $FEEDS"
    [ -w "$FEEDPROC" ] || die "$FEEDPROC not found: this kernel cannot verify feeds"
    mkdir -p "$SIGDIR"
    list=$(mktemp) && raw=$(mktemp) && rawsig=$(mktemp) || die "mktemp failed"
    trap 'rm -f "$list" "$raw" "$rawsig"' EXIT
    grep -v '^[[:space:]]*\(#\|$\)' "$FEEDS" > "$list"
    failed=0
    # `<format> <name> <url> [<key>]`: format `sigs` is hunter's own signature
    # lines, `sha256` a list with one SHA-256 per line (first field), as
    # abuse.ch's MalwareBazaar exports are. With a key, the feed must come with
    # `<url>.sig` signed by it, and is in `sigs` format: what is signed is
    # what the kernel loads, byte for byte.
    while read -r format name url key; do
        if ! valid_feed_name "$name"; then
            echo "hunterctl: bad feed name '$name'" >&2; failed=1; continue
        fi
        stage="$SIGDIR/.$name.new"
        rm -f "$stage" "$stage.sig"
        download "$url" "$raw" || { echo "hunterctl: $name: download failed: $url" >&2; failed=1; continue; }
        if [ -n "$key" ]; then
            if [ "$format" != sigs ]; then
                echo "hunterctl: $name: a signed feed must be in 'sigs' format" >&2; failed=1; continue
            fi
            if ! download "$url.sig" "$rawsig"; then
                echo "hunterctl: $name: no signature at $url.sig; not installed" >&2; failed=1; continue
            fi
            # The kernel checks that a trusted key signed it; that it is the
            # key the operator chose for THIS feed is checked here.
            if ! grep -qx "key $key" "$rawsig"; then
                echo "hunterctl: $name: not signed with key '$key'; not installed" >&2; failed=1; continue
            fi
            cp "$raw" "$stage" && cp "$rawsig" "$stage.sig" || die "cannot write $SIGDIR"
        else
            case "$format" in
                sigs)
                    grep -E '^(hash|bytes):' "$raw" > "$stage" ;;
                sha256)
                    awk -v n="$name" '!/^#/ && length($1) == 64 && $1 ~ /^[0-9a-fA-F]+$/ { print "hash:" tolower($1) ":" n }' "$raw" > "$stage" ;;
                *)
                    echo "hunterctl: $name: unknown feed format '$format'" >&2; failed=1; continue ;;
            esac
            # An empty or broken download must not replace a feed that worked.
            if [ ! -s "$stage" ]; then
                rm -f "$stage"
                echo "hunterctl: $name: no signatures in the download; keeping the old feed" >&2
                failed=1; continue
            fi
        fi
        install_feed install "$name" "$stage" || failed=1
    done < "$list"
    [ "$failed" = 0 ]
    ;;
feeds)
    [ -r "$FEEDPROC" ] || die "$FEEDPROC not found: this kernel cannot verify feeds"
    cat "$FEEDPROC"
    for d in "$HISTORY"/*/; do
        [ -d "$d" ] || continue
        n=$(basename "$d")
        echo "saved $n: $(versions "$n" | tr '\n' ' ')(installed: $(cat "$d/current" 2>/dev/null || echo -))"
    done
    ;;
feed-rollback)
    [ $# -eq 1 ] || [ $# -eq 2 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    [ -w "$FEEDPROC" ] || die "$FEEDPROC not found: this kernel cannot verify feeds"
    valid_feed_name "$1" || die "bad feed name '$1'"
    dir="$HISTORY/$1"
    [ -d "$dir" ] || die "no saved versions of $1"
    if [ $# -eq 2 ]; then
        ver=$2
    else
        cur=$(cat "$dir/current" 2>/dev/null || echo 0)
        ver=$(versions "$1" | awk -v c="$cur" '$1 < c { v = $1 } END { print v }')
        [ -n "$ver" ] || die "no saved version of $1 older than $cur"
    fi
    case "$ver" in ''|*[!0-9]*) die "a version is a number, see '$0 feeds'" ;; esac
    [ -f "$dir/$ver" ] || die "no saved version $ver of $1 (see '$0 feeds')"
    stage="$SIGDIR/.$1.new"
    rm -f "$stage" "$stage.sig"
    cp "$dir/$ver" "$stage" || die "cannot write $SIGDIR"
    [ -f "$dir/$ver.sig" ] && { cp "$dir/$ver.sig" "$stage.sig" || die "cannot write $SIGDIR"; }
    install_feed rollback "$1" "$stage" "$ver"
    ;;
save-learned)
    [ "$(id -u)" = 0 ] || die "must be root"
    mkdir -p "${WHITELIST%/*}"
    touch "$WHITELIST"
    tmp=$(mktemp) || die "mktemp failed"
    sed -n '/^learned-programs/,/^$/{/^  /s/^  //p}' "$PROC" > "$tmp"
    added=0
    while IFS= read -r p; do
        if ! grep -qxF -- "$p" "$WHITELIST"; then
            printf '%s\n' "$p" >> "$WHITELIST"
            added=$((added + 1))
        fi
    done < "$tmp"
    rm -f "$tmp"
    echo "hunterctl: $added program(s) added to $WHITELIST"
    ;;
*)
    usage 1
    ;;
esac
