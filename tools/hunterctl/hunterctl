    # process's memory, a /dev node a device) nor into the quarantine, whose
    # files are known malware already put away. So `scan /` means the disk,
    # as it does in lunarhunter.
    find "$@" \( -path /proc -o -path /sys -o -path /dev -o -path /run -o -path "$QDIR" \) -prune \
        -o -type f -print > "$list" 2>/dev/null
