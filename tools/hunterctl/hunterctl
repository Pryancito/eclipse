    line=$(grep -F "$TAB$1$TAB" "$QDIR/index" 2>/dev/null | tail -n 1)
    [ -n "$line" ] && [ -e "$QDIR/$1" ] || die "no quarantined file $1"
    mode=$(printf '%s\n' "$line" | cut -f3)
    dest=$(printf '%s\n' "$line" | cut -f4-)
