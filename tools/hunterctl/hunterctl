    # `media-device:` line in /proc/hunter; this walks one and reports the
    # verdict back with `media <id> ...`. lunarbar runs it on its own for each
    # new `state=pending` device; by hand it is for a console without the
    # desktop, or to scan a stick again.
    [ "$(id -u)" = 0 ] || die "must be root"
    [ -w "$SCAN" ] || die "$SCAN not found: this kernel's hunter has no antivirus"
    devs=$(grep '^media-device: ' "$PROC")
    # `target=` is the last field and may hold spaces: the rest of the line.
    target_of() {
        printf '%s\n' "$devs" | awk -v id="$1" '$2 == "id=" id { print substr($0, index($0, " target=") + 8); exit }'
    }
    if [ $# -eq 0 ]; then
        ids=$(printf '%s\n' "$devs" | awk '$3 == "state=pending" { print substr($2, 4) }')
        [ -n "$ids" ] || { echo "hunterctl: no media waiting for a scan"; exit 0; }
    else
        ids=""
        for a in "$@"; do
            case "$a" in
            ''|*[!0-9]*)
                real=$(readlink -f -- "$a") || die "cannot resolve $a"
                id=$(printf '%s\n' "$devs" | awk -v t="$real" 'substr($0, index($0, " target=") + 8) == t { print substr($2, 4); exit }')
                [ -n "$id" ] || die "$a is not a mounted removable device (see '$0 status')"
