#!/bin/sh
# hunterctl — operator front end for hunter, Eclipse OS's in-kernel security
# subsystem.
#
# Everything it changes goes through one door: a write to /proc/hunter, in
# hunter's control language (see docs/hunter-security.md). The kernel checks
# that the writer is root and applies each write all or nothing, so this
# script holds no policy of its own -- it only spells the directives.
#
#   hunterctl [status]              modes, counters, lists (no event ring)
#   hunterctl events                the full report, event ring included
#   hunterctl mode <domain> <mode>  domain: syscall|wx|exec|anomaly|integrity|av
#                                   mode:   off|report|enforce
#   hunterctl learning <on|off>
#   hunterctl anomaly-detection <on|off>
#   hunterctl privileged-deny <on|off>
#   hunterctl trust <path|dir/>     add to the exec allowlist
#   hunterctl deny <path|dir/>      add to the exec blacklist
#   hunterctl untrusted <dir/>      add a world-writable location
#   hunterctl seal                  one-way: from now on, only tighten
#   hunterctl apply <file>          send a whole policy script (e.g. policy.conf)
#   hunterctl hash <file>...        pin the SHA-256 of programs (live + /etc/hunter/hashes)
#   hunterctl require-hash <on|off> unpinned programs are integrity violations
#   hunterctl verify                check the files on disk against /etc/hunter/hashes
#   hunterctl scan [--quarantine] <path>...
#                                   antivirus scan of files/trees (exit 1 if infected)
#   hunterctl quarantine <file>...  move files into the quarantine and deny their paths
#   hunterctl quarantined           list the quarantine
#   hunterctl restore <sha256>      put a quarantined file back where it was
#   hunterctl update-signatures     download the feeds in /etc/hunter/feeds
#   hunterctl lockdown              enforce exec + integrity + av, learning off, seal
#   hunterctl schedule              the scheduled scans: when, last and next run
#   hunterctl schedule <job> <daily|mon..sun|off> [HH:MM] [report|quarantine]
#                                   change when a scheduled scan runs (/etc/hunter/schedule)
#   hunterctl run-scheduled <job|--due>
#                                   run a scheduled scan now (--due: every one that is due)
#   hunterctl scan-history [N]      the last N scheduled scans (default 20)
#   hunterctl scheduler             the daemon: run-scheduled --due once a minute
#   hunterctl save-learned          append learned programs to the whitelist

PROC=/proc/hunter
WHITELIST=/etc/hunter/whitelist
HASHES=/etc/hunter/hashes
SCAN=/proc/hunter_scan
QDIR=/var/lib/hunter/quarantine
FEEDS=/etc/hunter/feeds
SIGDIR=/etc/hunter/signatures.d
SCHEDULE=/etc/hunter/schedule
# The scheduled scans' state: `<job>.last` (when it last started, seconds
# since the epoch), `history` (one line per run) and the last LOGS reports.
SCANS=/var/lib/hunter/scans
LOGS=30
HISTORY_MAX=1000
# Paths per write to /proc/hunter_scan: each batch is scanned before the
# write returns, and 256 paths stay well under the 1 MiB a write may carry.
BATCH=256
TAB=$(printf '\t')

die() {
    echo "hunterctl: $*" >&2
    exit 1
}

usage() {
    sed -n '/^#   hunterctl \[status\]/,/^#   hunterctl save-learned/p' "$0" | sed 's/^#//'
    exit "${1:-0}"
}

# One write(2) per script: the kernel takes each write as a whole script, all
# or nothing. The script goes through a regular file and a single dd block
# larger than anything hunter accepts, because printf through stdio, or dd
# reading a pipe, could hand a long script over in two pieces -- and two
# halves are two different scripts.
send() {
    [ "$(id -u)" = 0 ] || die "must be root"
    msg=$(mktemp) || die "mktemp failed"
    printf '%s\n' "$1" > "$msg"
    if dd if="$msg" of="$PROC" bs=1048576 count=1 2>/dev/null; then
        rm -f "$msg"
    else
        rm -f "$msg"
        die "hunter rejected the script; nothing was applied (see '$0 events')"
    fi
}

# ── scheduled scans ─────────────────────────────────────────────────────────
#
# /etc/hunter/schedule, one job per line:
#
#   <job> <when> <HH:MM> <report|quarantine> <path>...
#
# `when` is `daily`, a weekday (`mon` .. `sun`) for once a week, or `off`.
# The times are the machine's local time. A job is due at the first slot
# after the one it last started in, so a machine that was off at 12:00 runs
# the day's scan as soon as it is back (anacron, not cron): a desktop is
# rarely on at the minute a cron line names.

# The UTC offset in seconds, from `date +%z` (+0000 when it says nothing).
tz_offset() {
    z=$(date +%z 2>/dev/null)
    case "$z" in
    [+-][0-9][0-9][0-9][0-9]) ;;
    *) echo 0; return ;;
    esac
    h=${z#?}; m=${h#??}; h=${h%??}
    # Without the leading zero, or ash reads 08 as a bad octal number.
    h=${h#0}; m=${m#0}
    o=$((h * 3600 + m * 60))
    case "$z" in -*) o=$((-o)) ;; esac
    echo "$o"
}

# The weekday's number, Monday 1 to Sunday 7 (ISO), or nothing.
weekday() {
    case "$1" in
    mon) echo 1 ;; tue) echo 2 ;; wed) echo 3 ;; thu) echo 4 ;;
    fri) echo 5 ;; sat) echo 6 ;; sun) echo 7 ;;
    esac
}

# Seconds after midnight for HH:MM, or fail.
time_of_day() {
    case "$1" in
    [0-2][0-9]:[0-5][0-9]) ;;
    *) return 1 ;;
    esac
    h=${1%%:*}; m=${1#*:}
    h=${h#0}; m=${m#0}
    [ "$h" -lt 24 ] || return 1
    echo $((h * 3600 + m * 60))
}

# next_slot <epoch> <when> <HH:MM> [offset]: the first slot strictly after
# <epoch>, in seconds since the epoch. Days are counted in local time, from
# 1970-01-01, a Thursday.
next_slot() {
    tod=$(time_of_day "$3") || return 1
    off=${4:-$(tz_offset)}
    loc=$(($1 + off))
    day=$((loc / 86400))
    if [ "$2" = daily ]; then
        cand=$((day * 86400 + tod))
        [ "$cand" -gt "$loc" ] || cand=$((cand + 86400))
    else
        want=$(weekday "$2")
        [ -n "$want" ] || return 1
        dow=$(((day + 3) % 7 + 1))
        cand=$(((day + (want - dow + 7) % 7) * 86400 + tod))
        [ "$cand" -gt "$loc" ] || cand=$((cand + 7 * 86400))
    fi
    echo $((cand - off))
}

# `YYYY-MM-DD HH:MM` for an epoch (busybox and GNU date both take `@`).
when_str() {
    date -d "@$1" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "@$1"
}

# The jobs, comments and blank lines left out.
schedule_lines() {
    [ -r "$SCHEDULE" ] && grep -v '^[[:space:]]*\(#\|$\)' "$SCHEDULE"
}

# run_job <job> <scheduled|manual>: scan the job's paths, record the run.
run_job() {
    line=$(schedule_lines | awk -v j="$1" '$1 == j' | head -n 1)
    [ -n "$line" ] || die "no job '$1' in $SCHEDULE"
    trigger=$2
    set -f
    # shellcheck disable=SC2086
    set -- $line
    set +f
    job=$1; action=$4
    shift 4
    paths=" $*"
    [ "$paths" != " " ] || die "job '$job' has no paths"
    mkdir -p "$SCANS" && chmod 700 "$SCANS" || die "cannot create $SCANS"
    # One scan at a time: two of them would halve each other's speed for no
    # gain. A pid file and not a directory, so one left by a crash or a
    # power cut does not block every scan after it.
    if [ -r "$SCANS/lock" ] && kill -0 "$(cat "$SCANS/lock")" 2>/dev/null; then
        echo "hunterctl: another scan is running (pid $(cat "$SCANS/lock")); $job not run" >&2
        return 1
    fi
    echo $$ > "$SCANS/lock"
    start=$(date +%s)
    # Before the scan, not after: a scan that crashes the machine must not
    # run again at every boot.
    echo "$start" > "$SCANS/$job.last"
    log="$SCANS/$(date -d "@$start" +%Y%m%d-%H%M%S 2>/dev/null || echo "$start")-$job.log"
    q=""
    [ "$action" = quarantine ] && q="--quarantine"
    echo "hunterctl: $job: scanning$paths"
    set -f
    # shellcheck disable=SC2086
    "$0" scan $q $paths > "$log" 2>&1
    set +f
    secs=$(($(date +%s) - start))
    sum=$(sed -n 's/^hunterctl: scanned \([0-9]*\) file(s), \([0-9]*\) infected$/\1 \2/p' "$log" | tail -n 1)
    if [ -n "$sum" ]; then
        files=${sum% *}; infected=${sum#* }
        if [ "$infected" -gt 0 ]; then status=infected; else status=clean; fi
    else
        files=0; infected=0; status=failed
    fi
    quarantined=$(grep -c '^hunterctl: quarantined ' "$log")
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -d "@$start" +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo "$start")" \
        "$job" "$trigger" "$secs" "$files" "$infected" "$quarantined" "$status" "${log##*/}" >> "$SCANS/history"
    # Bounded: the newest HISTORY_MAX runs and LOGS reports.
    if [ "$(wc -l < "$SCANS/history")" -gt "$HISTORY_MAX" ]; then
        tail -n "$HISTORY_MAX" "$SCANS/history" > "$SCANS/history.new" && mv "$SCANS/history.new" "$SCANS/history"
    fi
    ls -1 "$SCANS" | grep '\.log$' | sort -r | sed "1,${LOGS}d" | while IFS= read -r old; do
        rm -f "$SCANS/$old"
    done
    rm -f "$SCANS/lock"
    grep -v '^hunterctl: scanned ' "$log"
    echo "hunterctl: $job: $status, $files file(s), $infected infected, $quarantined quarantined, ${secs}s (report: $log)"
    [ "$status" = clean ]
}

cmd=${1:-status}
[ $# -gt 0 ] && shift

case "$cmd" in
-h|--help|help) usage 0 ;;
esac

[ -r "$PROC" ] || die "$PROC not found: is this an Eclipse OS kernel with hunter?"

case "$cmd" in
status)
    sed '/^recent events/,$d' "$PROC"
    ;;
events)
    cat "$PROC"
    ;;
mode)
    [ $# -eq 2 ] || usage 1
    send "mode $1 $2"
    ;;
learning|anomaly-detection|privileged-deny|require-hash|trust|deny|untrusted)
    [ $# -eq 1 ] || usage 1
    send "$cmd $1"
    ;;
seal)
    send "seal"
    ;;
apply)
    [ $# -eq 1 ] || usage 1
    [ -r "$1" ] || die "cannot read $1"
    send "$(cat "$1")"
    ;;
hash)
    [ $# -ge 1 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    # Pinned by the file's real path: the kernel checks a program by its name
    # AND by the path it resolves to, so pinning the target covers every link
    # to it. One script for all of them, so the batch is all or nothing too.
    script=""
    mkdir -p "${HASHES%/*}"
    touch "$HASHES"
    tmp=$(mktemp) || die "mktemp failed"
    trap 'rm -f "$tmp" "$tmp.new"' EXIT
    cp "$HASHES" "$tmp"
    for f in "$@"; do
        real=$(readlink -f -- "$f") || die "cannot resolve $f"
        [ -f "$real" ] || die "not a file: $f"
        sum=$(sha256sum -- "$real" | cut -d' ' -f1) || die "cannot hash $real"
        # Replace an earlier pin of the same file rather than stacking a
        # second, stale line under it.
        # (A sha256sum line is 64 hex digits, two spaces, then the path.)
        awk -v p="$real" 'substr($0, 67) != p' "$tmp" > "$tmp.new"
        printf '%s  %s\n' "$sum" "$real" >> "$tmp.new"
        mv "$tmp.new" "$tmp"
        script="${script}hash $sum  $real
"
    done
    send "$script"
    mv "$tmp" "$HASHES"
    echo "hunterctl: pinned $# program(s); $(grep -c . "$HASHES") in $HASHES"
    ;;
verify)
    [ -r "$HASHES" ] || die "no $HASHES"
    sha256sum -c "$HASHES"
    ;;
lockdown)
    # Exec and integrity. W^X stays where it is because enforcing it breaks
    # every JIT (Firefox, any JS engine), and the anomaly heuristics cost a
    # lock on every syscall; both are a deliberate `mode` away. Whatever was
    # learned or pinned so far stays trusted, so run save-learned (and hash)
    # first. After this an updated binary whose pin no longer matches will
    # not run until reboot: re-pinning is a relaxation, and the seal refuses
    # it.
    send "mode exec enforce
mode integrity enforce
mode av enforce
learning off
seal"
    ;;
scan)
    [ "$(id -u)" = 0 ] || die "must be root"
    quarantine=0
    if [ "${1:-}" = "--quarantine" ]; then
        quarantine=1
        shift
    fi
    [ $# -ge 1 ] || usage 1
    [ -w "$SCAN" ] || die "$SCAN not found: this kernel's hunter has no antivirus"
    list=$(mktemp) && out=$(mktemp) && batch=$(mktemp) || die "mktemp failed"
    trap 'rm -f "$list" "$out" "$batch"' EXIT
    # Not into the kernel's own trees (a /proc file is endless or a live
    # process's memory, a /dev node a device) nor into the quarantine, whose
    # files are known malware already put away. So `scan /` means the disk,
    # as it does in lunarhunter.
    find "$@" \( -path /proc -o -path /sys -o -path /dev -o -path /run -o -path "$QDIR" \) -prune \
        -o -type f -print > "$list" 2>/dev/null
    total=$(wc -l < "$list")
    i=1
    while [ "$i" -le "$total" ]; do
        sed -n "${i},$((i + BATCH - 1))p" "$list" > "$batch"
        dd if="$batch" of="$SCAN" bs=1048576 count=1 2>/dev/null || die "scan write failed"
        cat "$SCAN" >> "$out"
        i=$((i + BATCH))
    done
    grep -E ' FOUND$|: ERROR ' "$out"
    infected=$(grep -c ' FOUND$' "$out")
    echo "hunterctl: scanned $total file(s), $infected infected"
    if [ "$infected" -gt 0 ] && [ "$quarantine" = 1 ]; then
        sed -n 's/: [^ ]* FOUND$//p' "$out" | while IFS= read -r f; do
            "$0" quarantine "$f"
        done
    fi
    [ "$infected" -eq 0 ]
    ;;
quarantine)
    [ $# -ge 1 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    mkdir -p "$QDIR" && chmod 700 "$QDIR" || die "cannot create $QDIR"
    for f in "$@"; do
        real=$(readlink -f -- "$f") || die "cannot resolve $f"
        [ -f "$real" ] || die "not a file: $f"
        sum=$(sha256sum -- "$real" | cut -d' ' -f1)
        mode=$(stat -c %a -- "$real")
        mv -- "$real" "$QDIR/$sum" || die "cannot move $real"
        chmod 000 "$QDIR/$sum"
        printf '%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$sum" "$mode" "$real" >> "$QDIR/index"
        # A copy dropped at the same path again must not run either. The
        # blacklist lasts until reboot (hunter never forgets a deny).
        send "deny $real"
        echo "hunterctl: quarantined $real ($sum)"
    done
    ;;
quarantined)
    [ -r "$QDIR/index" ] || { echo "hunterctl: quarantine is empty"; exit 0; }
    cat "$QDIR/index"
    ;;
restore)
    [ $# -eq 1 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    line=$(grep -F "$TAB$1$TAB" "$QDIR/index" 2>/dev/null | tail -n 1)
    [ -n "$line" ] && [ -e "$QDIR/$1" ] || die "no quarantined file $1"
    mode=$(printf '%s\n' "$line" | cut -f3)
    dest=$(printf '%s\n' "$line" | cut -f4-)
    [ -e "$dest" ] && die "$dest exists; not overwriting it"
    mv -- "$QDIR/$1" "$dest" && chmod "$mode" "$dest" || die "cannot restore to $dest"
    grep -vF "$TAB$1$TAB" "$QDIR/index" > "$QDIR/index.new"; mv "$QDIR/index.new" "$QDIR/index"
    echo "hunterctl: restored $dest (its path stays denied until reboot)"
    ;;
update-signatures)
    [ "$(id -u)" = 0 ] || die "must be root"
    [ -r "$FEEDS" ] || die "no $FEEDS"
    mkdir -p "$SIGDIR"
    raw=$(mktemp) && sigs=$(mktemp) && part=$(mktemp) || die "mktemp failed"
    trap 'rm -f "$raw" "$sigs" "$part"' EXIT
    # `<format> <name> <url>`: format `sigs` is hunter's own signature lines,
    # `sha256` a list with one SHA-256 per line (first field), as abuse.ch's
    # MalwareBazaar exports are.
    grep -v '^[[:space:]]*\(#\|$\)' "$FEEDS" | while read -r format name url; do
        case "$name" in
            ''|*/*|.*) echo "hunterctl: bad feed name '$name'" >&2; continue ;;
        esac
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL --max-time 300 -o "$raw" "$url"
        else
            wget -q -T 300 -O "$raw" "$url"
        fi || { echo "hunterctl: $name: download failed: $url" >&2; continue; }
        case "$format" in
            sigs)
                grep -E '^(hash|bytes):' "$raw" > "$sigs" ;;
            sha256)
                awk -v n="$name" '!/^#/ && length($1) == 64 && $1 ~ /^[0-9a-fA-F]+$/ { print "hash:" tolower($1) ":" n }' "$raw" > "$sigs" ;;
            *)
                echo "hunterctl: $name: unknown feed format '$format'" >&2; continue ;;
        esac
        count=$(wc -l < "$sigs")
        # An empty or broken download must not replace a feed that worked.
        if [ "$count" -eq 0 ]; then
            echo "hunterctl: $name: no signatures in the download; keeping the old feed" >&2
            continue
        fi
        # Live, in batches the kernel takes whole: a batch with a line it
        # cannot parse is refused entirely, and the feed is not installed.
        ok=1
        total=$count
        i=1
        while [ "$i" -le "$total" ]; do
            sed -n "${i},$((i + 4999))p" "$sigs" | sed 's/^/signature /' > "$part"
            dd if="$part" of="$PROC" bs=4194304 count=1 2>/dev/null || { ok=0; break; }
            i=$((i + 5000))
        done
        if [ "$ok" = 1 ]; then
            # Into a dot-file first (the kernel skips those), then renamed:
            # a reboot halfway through finds the old feed or the new one.
            cp "$sigs" "$SIGDIR/.$name.new" && mv "$SIGDIR/.$name.new" "$SIGDIR/$name"
            echo "hunterctl: $name: $count signature(s)"
        else
            echo "hunterctl: $name: hunter rejected the feed; not installed" >&2
        fi
    done
    ;;
schedule)
    if [ $# -eq 0 ]; then
        [ -r "$SCHEDULE" ] || die "no $SCHEDULE"
        now=$(date +%s)
        schedule_lines | while read -r job when at action paths; do
            last=$(cat "$SCANS/$job.last" 2>/dev/null)
            if [ "$when" = off ]; then
                next=off
            else
                n=$(next_slot "${last:-$now}" "$when" "$at") && next=$(when_str "$n") || next="bad schedule"
            fi
            [ -n "$last" ] && last=$(when_str "$last") || last=never
            printf '%s\t%s %s, %s\n\tlast: %s\tnext: %s\n\tpaths: %s\n' \
                "$job" "$when" "$at" "$action" "$last" "$next" "$paths"
        done
        exit 0
    fi
    [ $# -ge 2 ] && [ $# -le 4 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    [ -r "$SCHEDULE" ] || die "no $SCHEDULE"
    job=$1 when=$2 at="" action=""
    case "$job" in ''|*[!A-Za-z0-9_-]*) die "bad job name '$job'" ;; esac
    case "$when" in
    daily|off) ;;
    *) [ -n "$(weekday "$when")" ] || die "when: daily, mon..sun or off, not '$when'" ;;
    esac
    shift 2
    for a in "$@"; do
        case "$a" in
        report|quarantine) action=$a ;;
        *) time_of_day "$a" >/dev/null || die "not a time (HH:MM): $a"; at=$a ;;
        esac
    done
    grep -q "^[[:space:]]*$job[[:space:]]" "$SCHEDULE" || die "no job '$job' in $SCHEDULE"
    # Only the fields asked for change; the rest of the line, and every
    # other line (comments included), stays as the operator wrote it.
    tmp=$(mktemp) || die "mktemp failed"
    awk -v j="$job" -v w="$when" -v t="$at" -v a="$action" '
        !/^[[:space:]]*#/ && $1 == j {
            $2 = w
            if (t != "") $3 = t
            if (a != "") $4 = a
        }
        { print }' "$SCHEDULE" > "$tmp" && cat "$tmp" > "$SCHEDULE"
    rm -f "$tmp"
    "$0" schedule
    ;;
run-scheduled)
    [ $# -eq 1 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    if [ "$1" != --due ]; then
        run_job "$1" manual
        exit $?
    fi
    now=$(date +%s)
    rc=0
    mkdir -p "$SCANS" && chmod 700 "$SCANS" || die "cannot create $SCANS"
    for job in $(schedule_lines | awk '$2 != "off" { print $1 }'); do
        set -- $(schedule_lines | awk -v j="$job" '$1 == j { print $2, $3; exit }')
        last=$(cat "$SCANS/$job.last" 2>/dev/null)
        # A job seen for the first time starts counting now: its first run
        # is its next slot, not this minute. And a clock that went back
        # (an RTC reset, before NTP) must not hold a job off for days.
        if [ -z "$last" ] || [ "$last" -gt $((now + 86400)) ]; then
            echo "$now" > "$SCANS/$job.last"
            continue
        fi
        next=$(next_slot "$last" "$1" "$2") || { echo "hunterctl: $job: bad schedule" >&2; continue; }
        if [ "$now" -ge "$next" ]; then
            run_job "$job" scheduled || rc=1
        fi
    done
    exit "$rc"
    ;;
scan-history)
    n=${1:-20}
    case "$n" in ''|*[!0-9]*) usage 1 ;; esac
    [ -r "$SCANS/history" ] || { echo "hunterctl: no scheduled scan has run yet"; exit 0; }
    printf 'date\tjob\ttrigger\tseconds\tfiles\tinfected\tquarantined\tstatus\treport\n'
    tail -n "$n" "$SCANS/history"
    ;;
scheduler)
    [ "$(id -u)" = 0 ] || die "must be root"
    # In the foreground, for eclipse-init to supervise. A failed scan is
    # in the history; the loop carries on.
    while :; do
        "$0" run-scheduled --due
        sleep 60
    done
    ;;
save-learned)
    [ "$(id -u)" = 0 ] || die "must be root"
    mkdir -p "${WHITELIST%/*}"
    touch "$WHITELIST"
    tmp=$(mktemp) || die "mktemp failed"
    sed -n '/^learned-programs/,/^$/{/^  /s/^  //p}' "$PROC" > "$tmp"
    added=0
    while IFS= read -r p; do
        if ! grep -qxF -- "$p" "$WHITELIST"; then
            printf '%s\n' "$p" >> "$WHITELIST"
            added=$((added + 1))
        fi
    done < "$tmp"
    rm -f "$tmp"
    echo "hunterctl: $added program(s) added to $WHITELIST"
    ;;
*)
    usage 1
    ;;
esac
