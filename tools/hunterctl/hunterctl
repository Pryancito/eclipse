            if [ "$format" != sigs ]; then
                echo "hunterctl: $name: a signed feed must be in 'sigs' format" >&2; failed=1; continue
            fi
            if ! download "$url.sig" "$rawsig"; then
                echo "hunterctl: $name: no signature at $url.sig; not installed" >&2; failed=1; continue
            fi
