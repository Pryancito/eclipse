#!/bin/sh
# hunterctl — operator front end for hunter, Eclipse OS's in-kernel security
# subsystem.
#
# Everything it changes goes through one door: a write to /proc/hunter, in
# hunter's control language (see docs/hunter-security.md). The kernel checks
# that the writer is root and applies each write all or nothing, so this
# script holds no policy of its own -- it only spells the directives.
#
#   hunterctl [status]              modes, counters, lists (no event ring)
#   hunterctl events                the full report, event ring included
#   hunterctl mode <domain> <mode>  domain: syscall|wx|exec|anomaly|integrity|av|behavior
#                                   mode:   off|report|enforce
#   hunterctl learning <on|off>
#   hunterctl anomaly-detection <on|off>
#   hunterctl privileged-deny <on|off>
#   hunterctl trust <path|dir/>     add to the exec allowlist
#   hunterctl deny <path|dir/>      add to the exec blacklist
#   hunterctl untrusted <dir/>      add a world-writable location
#   hunterctl canary <file>...      ransomware tripwire: create decoy files, declare
#                                   them now and in /etc/hunter/policy.conf
#   hunterctl exempt <program>      the ransomware/injection detectors leave it alone
#   hunterctl release <pid>         lift a process's ransomware containment
#   hunterctl seal                  one-way: from now on, only tighten
#   hunterctl apply <file>          send a whole policy script (e.g. policy.conf)
#   hunterctl hash <file>...        pin the SHA-256 of programs (live + /etc/hunter/hashes)
#   hunterctl require-hash <on|off> unpinned programs are integrity violations
#   hunterctl verify                check the files on disk against /etc/hunter/hashes
#   hunterctl boot                  boot integrity: verdict, measured and pinned digests
#   hunterctl boot pin [item...]    pin this boot's measurements (live + /etc/hunter/boot)
#   hunterctl boot verify           re-hash the kernel's code now (exit 1 if tampered)
#   hunterctl scan [--quarantine] <path>...
#                                   antivirus scan of files/trees (exit 1 if infected)
#   hunterctl scan-media [id|dir]...
#                                   scan removable media (default: every pending one)
#   hunterctl media-scan <on|off>   queue new USB sticks / disks for a scan
#   hunterctl media-lock <on|off>   nothing runs from media until it scans clean
#   hunterctl quarantine <file>...  move files into the quarantine and deny their paths
#   hunterctl quarantined           list the quarantine
#   hunterctl restore <sha256>      put a quarantined file back where it was
#   hunterctl update-signatures     download the feeds in /etc/hunter/feeds (signed
#                                   ones are verified by the kernel before use)
#   hunterctl feeds                 installed feeds, trusted keys, saved versions
#   hunterctl feed-rollback <feed> [<version>]
#                                   go back to a saved version (default: the one
#                                   before the installed one)
#   hunterctl trust-key <name> <hex>
#                                   trust an Ed25519 feed key (live + /etc/hunter/keys)
#   hunterctl require-signed-feeds <on|off>
#                                   refuse feeds without a valid signature
#   hunterctl lockdown              enforce exec + integrity + av, learning off, seal
#   hunterctl report [--pdf|--txt] [--days N] [-o FILE]
#                                   security report of the last N days (default 7),
#                                   HTML by default, into /var/lib/hunter/reports/
#   hunterctl schedule              the scheduled scans: when, last and next run
#   hunterctl schedule <job> <daily|mon..sun|off> [HH:MM] [report|quarantine]
#                                   change when a scheduled scan runs (/etc/hunter/schedule)
#   hunterctl run-scheduled <job|--due>
#                                   run a scheduled scan now (--due: every one that is due)
#   hunterctl scan-history [N]      the last N scheduled scans (default 20)
#   hunterctl scheduler             the daemon: run-scheduled --due once a minute
#   hunterctl net                   sockets per process; ALERT = unexpected listener
#   hunterctl expect-port <tcp|udp|any> <port|lo-hi> [program]
#                                   that listener is expected (live + /etc/hunter/ports)
#   hunterctl forget-port <tcp|udp|any> <port|lo-hi> [program]
#                                   take an expect-port back
#   hunterctl save-learned          append learned programs to the whitelist
#   hunterctl notify [--severity info|warn|crit] [--timeout SECS]
#                    [--action ID:LABEL[:COMMAND]]... [--wait SECS] TITLE [BODY]
#                                   pop up a notification on the desktop (lunarbar);
#                                   with --wait, print the button pressed
#   hunterctl daemon [seconds]      hunterd: keep events and learned programs on disk
#   hunterctl persist               one pass of the daemon, now
#   hunterctl history [--alerts|--critical] [--this-boot] [N]
#                                   the last N events kept on disk (default 50, 0 = all)

# HUNTERCTL_ROOT puts every path below under another directory, which is how
# the tests drive the daemon against a fake /proc on the build host.
R=${HUNTERCTL_ROOT:-}
PROC=$R/proc/hunter
WHITELIST=/etc/hunter/whitelist
HASHES=/etc/hunter/hashes
SCAN=/proc/hunter_scan
BOOTPROC=/proc/hunter_boot
BOOTPINS=/etc/hunter/boot
QDIR=/var/lib/hunter/quarantine
FEEDS=/etc/hunter/feeds
POLICY=/etc/hunter/policy.conf
SIGDIR=/etc/hunter/signatures.d
REPORTS=/var/lib/hunter/reports
# The report is rendered by lunarhunter (lunarbar's hunter_export), the one
# place that knows the three formats: two renderings of the same report would
# drift apart the way two parsers of /proc/hunter would.
LUNARHUNTER=/bin/lunarhunter
# The desktop's notification spool: one file per alert, read by lunarbar (see
# tools/lunarbar/src/hunter_notify.rs for the format). Under /run, so a reboot
# forgets what nobody answered.
NOTIFY=/run/hunter/notify
SCHEDULE=/etc/hunter/schedule
# The scheduled scans' state: `<job>.last` (when it last started, seconds
# since the epoch), `history` (one line per run) and the last LOGS reports.
SCANS=/var/lib/hunter/scans
LOGS=30
HISTORY_MAX=1000
# One report per scanned device (`hunterctl scan-media`), named by its id:
# the FOUND / ERROR lines and a summary. lunarhunter shows them.
MEDIA_REPORTS=/run/hunter/media
NET=/proc/hunter_net
PORTS=/etc/hunter/ports
FEEDPROC=/proc/hunter_feed
KEYS=/etc/hunter/keys
# Every feed version that was installed, by version (a signed feed's serial,
# an unsigned one's UTC download time), for feed-rollback.
HISTORY=/var/lib/hunter/feeds
KEEP=5
# Paths per write to /proc/hunter_scan: each batch is scanned before the
# write returns, and 256 paths stay well under the 1 MiB a write may carry.
BATCH=256
TAB=$(printf '\t')
# hunterd's files. The event history is a log (and readable by the adm
# group, like the rest of /var/log); the learned set and the cursor are
# state, and the learned set is something the kernel trusts at boot, so only
# root may read or write any of it.
LOGDIR=$R/var/log/hunter
EVENTS=$LOGDIR/events.log
STATEDIR=$R/var/lib/hunter
LEARNED=$STATEDIR/learned
CURSOR=$STATEDIR/events.cursor
# events.log is rotated past LOG_MAX bytes into events.log.1 .. .LOG_KEEP, so
# the history costs at most (LOG_KEEP + 1) * LOG_MAX of disk: 5 MiB.
LOG_MAX=${HUNTERD_LOG_MAX:-1048576}
LOG_KEEP=4

die() {
    echo "hunterctl: $*" >&2
    exit 1
}

usage() {
    sed -n '/^#   hunterctl \[status\]/,/^#  *the last N events/p' "$0" | sed 's/^#//'
    exit "${1:-0}"
}

# One write(2) per script: the kernel takes each write as a whole script, all
# or nothing. The script goes through a regular file and a single dd block
# larger than anything hunter accepts, because printf through stdio, or dd
# reading a pipe, could hand a long script over in two pieces -- and two
# halves are two different scripts.
send() {
    [ "$(id -u)" = 0 ] || die "must be root"
    msg=$(mktemp) || die "mktemp failed"
    printf '%s\n' "$1" > "$msg"
    if dd if="$msg" of="${2:-$PROC}" bs=1048576 count=1 2>/dev/null; then
        rm -f "$msg"
    else
        rm -f "$msg"
        die "hunter rejected the script; nothing was applied (see '$0 events')"
    fi
}

# Fields go one per line, so no newline (and no tab, which separates an
# action's fields) may survive into one.
oneline() {
    printf '%s' "$1" | tr '\t\n\r' '   '
}

# The one door anything on the system uses to tell the user something, or ask:
# a scheduled scan, the firewall's "may X connect?", a USB stick scanned on
# mount. lunarbar shows the card, runs the COMMAND of the button pressed, and,
# with --wait, writes back the ID of that button (or `dismiss` / `timeout`),
# which this prints. Exit 0 answered, 2 timed out. Without --wait, prints the
# alert's id. Needs no hunter in the kernel, only root: the bar runs the
# commands in these files, so it trusts only a root-owned spool.
notify() {
    [ "$(id -u)" = 0 ] || die "must be root"
    sev=info timeout="" wait="" actions=""
    while [ $# -gt 0 ]; do
        case "$1" in
        --severity|--timeout|--action|--wait)
            [ $# -ge 2 ] || usage 1
            case "$1" in
            --severity) sev=$2 ;;
            --timeout) timeout=$2 ;;
            --wait) wait=$2 ;;
            --action)
                case "$2" in
                *:?*) ;;
                *) die "--action wants ID:LABEL[:COMMAND], got '$2'" ;;
                esac
                actions="$actions$(oneline "$2")
" ;;
            esac
            shift 2 ;;
        --) shift; break ;;
        -*) usage 1 ;;
        *) break ;;
        esac
    done
    [ $# -ge 1 ] && [ $# -le 2 ] || usage 1
    case "$sev" in info|warn|crit) ;; *) die "severity is info, warn or crit" ;; esac
    for n in "$timeout" "$wait"; do
        case "$n" in ''|*[!0-9]*) [ -z "$n" ] || die "not a number of seconds: $n" ;; esac
    done
    mkdir -p "$NOTIFY" && chmod 700 "$NOTIFY" || die "cannot create $NOTIFY"
    id="$(date +%s)-$$"
    # Written under a dot-name and renamed: the bar never reads half a file.
    tmp="$NOTIFY/.$id"
    {
        echo "severity=$sev"
        echo "title=$(oneline "$1")"
        [ -n "${2:-}" ] && echo "body=$(oneline "$2")"
        [ -n "$timeout" ] && echo "timeout=$timeout"
        [ -n "$wait" ] && echo "reply=1"
        printf '%s' "$actions" | while IFS= read -r a; do
            aid=${a%%:*}
            rest=${a#*:}
            label=${rest%%:*}
            run=""
            [ "$label" != "$rest" ] && run=${rest#*:}
            printf 'action=%s\t%s\t%s\n' "$aid" "$label" "$run"
        done
    } > "$tmp" || die "cannot write $tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$NOTIFY/$id.alert" || die "cannot post the alert"
    if [ -z "$wait" ]; then
        echo "$id"
        return 0
    fi
    i=0
    while [ "$i" -lt "$wait" ]; do
        if [ -f "$NOTIFY/$id.answer" ]; then
            ans=$(cat "$NOTIFY/$id.answer")
            rm -f "$NOTIFY/$id.answer"
            echo "$ans"
            [ "$ans" = timeout ] && return 2
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    # Taking the file away takes the card down at the bar's next tick.
    rm -f "$NOTIFY/$id.alert"
    echo timeout
    return 2
}

# ── scheduled scans ─────────────────────────────────────────────────────────
#
# /etc/hunter/schedule, one job per line:
#
#   <job> <when> <HH:MM> <report|quarantine> <path>...
#
# `when` is `daily`, a weekday (`mon` .. `sun`) for once a week, or `off`.
# The times are the machine's local time. A job is due at the first slot
# after the one it last started in, so a machine that was off at 12:00 runs
# the day's scan as soon as it is back (anacron, not cron): a desktop is
# rarely on at the minute a cron line names.

# The UTC offset in seconds, from `date +%z` (+0000 when it says nothing).
tz_offset() {
    z=$(date +%z 2>/dev/null)
    case "$z" in
    [+-][0-9][0-9][0-9][0-9]) ;;
    *) echo 0; return ;;
    esac
    h=${z#?}; m=${h#??}; h=${h%??}
    # Without the leading zero, or ash reads 08 as a bad octal number.
    h=${h#0}; m=${m#0}
    o=$((h * 3600 + m * 60))
    case "$z" in -*) o=$((-o)) ;; esac
    echo "$o"
}

# The weekday's number, Monday 1 to Sunday 7 (ISO), or nothing.
weekday() {
    case "$1" in
    mon) echo 1 ;; tue) echo 2 ;; wed) echo 3 ;; thu) echo 4 ;;
    fri) echo 5 ;; sat) echo 6 ;; sun) echo 7 ;;
    esac
}

# Seconds after midnight for HH:MM, or fail.
time_of_day() {
    case "$1" in
    [0-2][0-9]:[0-5][0-9]) ;;
    *) return 1 ;;
    esac
    h=${1%%:*}; m=${1#*:}
    h=${h#0}; m=${m#0}
    [ "$h" -lt 24 ] || return 1
    echo $((h * 3600 + m * 60))
}

# next_slot <epoch> <when> <HH:MM> [offset]: the first slot strictly after
# <epoch>, in seconds since the epoch. Days are counted in local time, from
# 1970-01-01, a Thursday.
next_slot() {
    tod=$(time_of_day "$3") || return 1
    off=${4:-$(tz_offset)}
    loc=$(($1 + off))
    day=$((loc / 86400))
    if [ "$2" = daily ]; then
        cand=$((day * 86400 + tod))
        [ "$cand" -gt "$loc" ] || cand=$((cand + 86400))
    else
        want=$(weekday "$2")
        [ -n "$want" ] || return 1
        dow=$(((day + 3) % 7 + 1))
        cand=$(((day + (want - dow + 7) % 7) * 86400 + tod))
        [ "$cand" -gt "$loc" ] || cand=$((cand + 7 * 86400))
    fi
    echo $((cand - off))
}

# `YYYY-MM-DD HH:MM` for an epoch (busybox and GNU date both take `@`).
when_str() {
    date -d "@$1" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "@$1"
}

# The jobs, comments and blank lines left out.
schedule_lines() {
    [ -r "$SCHEDULE" ] && grep -v '^[[:space:]]*\(#\|$\)' "$SCHEDULE"
}

# run_job <job> <scheduled|manual>: scan the job's paths, record the run.
run_job() {
    line=$(schedule_lines | awk -v j="$1" '$1 == j' | head -n 1)
    [ -n "$line" ] || die "no job '$1' in $SCHEDULE"
    trigger=$2
    set -f
    # shellcheck disable=SC2086
    set -- $line
    set +f
    job=$1; action=$4
    shift 4
    paths=" $*"
    [ "$paths" != " " ] || die "job '$job' has no paths"
    mkdir -p "$SCANS" && chmod 700 "$SCANS" || die "cannot create $SCANS"
    # One scan at a time: two of them would halve each other's speed for no
    # gain. A pid file and not a directory, so one left by a crash or a
    # power cut does not block every scan after it.
    if [ -r "$SCANS/lock" ] && kill -0 "$(cat "$SCANS/lock")" 2>/dev/null; then
        echo "hunterctl: another scan is running (pid $(cat "$SCANS/lock")); $job not run" >&2
        return 1
    fi
    echo $$ > "$SCANS/lock"
    start=$(date +%s)
    # Before the scan, not after: a scan that crashes the machine must not
    # run again at every boot.
    echo "$start" > "$SCANS/$job.last"
    log="$SCANS/$(date -d "@$start" +%Y%m%d-%H%M%S 2>/dev/null || echo "$start")-$job.log"
    q=""
    [ "$action" = quarantine ] && q="--quarantine"
    echo "hunterctl: $job: scanning$paths"
    set -f
    # shellcheck disable=SC2086
    "$0" scan $q $paths > "$log" 2>&1
    set +f
    secs=$(($(date +%s) - start))
    sum=$(sed -n 's/^hunterctl: scanned \([0-9]*\) file(s), \([0-9]*\) infected$/\1 \2/p' "$log" | tail -n 1)
    if [ -n "$sum" ]; then
        files=${sum% *}; infected=${sum#* }
        if [ "$infected" -gt 0 ]; then status=infected; else status=clean; fi
    else
        files=0; infected=0; status=failed
    fi
    quarantined=$(grep -c '^hunterctl: quarantined ' "$log")
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -d "@$start" +%Y-%m-%dT%H:%M:%S 2>/dev/null || echo "$start")" \
        "$job" "$trigger" "$secs" "$files" "$infected" "$quarantined" "$status" "${log##*/}" >> "$SCANS/history"
    # Bounded: the newest HISTORY_MAX runs and LOGS reports.
    if [ "$(wc -l < "$SCANS/history")" -gt "$HISTORY_MAX" ]; then
        tail -n "$HISTORY_MAX" "$SCANS/history" > "$SCANS/history.new" && mv "$SCANS/history.new" "$SCANS/history"
    fi
    ls -1 "$SCANS" | grep '\.log$' | sort -r | sed "1,${LOGS}d" | while IFS= read -r old; do
        rm -f "$SCANS/$old"
    done
    rm -f "$SCANS/lock"
    grep -v '^hunterctl: scanned ' "$log"
    echo "hunterctl: $job: $status, $files file(s), $infected infected, $quarantined quarantined, ${secs}s (report: $log)"
    [ "$status" = clean ]
}

download() {
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL --max-time 300 -o "$2" "$1"
    else
        wget -q -T 300 -O "$2" "$1"
    fi
}

# The names the kernel takes for a feed: a plain file name in signatures.d,
# neither hidden nor a `.sig`.
valid_feed_name() {
    case "$1" in
        ''|.*|*.sig|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
    [ "${#1}" -le 64 ]
}

# The saved versions of a feed, oldest first.
versions() {
    ls "$HISTORY/$1" 2>/dev/null | grep -E '^[0-9]+$' | sort -n
}

# install_feed <install|rollback> <name> <staged file> [<version>]: asks the kernel to
# verify the staged feed (and `<staged file>.sig` when there is one) and load
# it; only once it said yes is the feed moved into signatures.d, where the
# next boot finds it, and (a new version) saved for feed-rollback.
install_feed() {
    how=$1 name=$2 stage=$3
    if [ -f "$stage.sig" ]; then
        req="$how $name $stage $stage.sig"
        ver=$(sed -n 's/^serial //p' "$stage.sig")
    else
        req="$how $name $stage"
        ver=$(date -u +%Y%m%d%H%M%S)
    fi
    if ! printf '%s\n' "$req" > "$FEEDPROC" 2>/dev/null; then
        rm -f "$stage" "$stage.sig"
        echo "hunterctl: $(sed -n 's/^last: //p' "$FEEDPROC")" >&2
        return 1
    fi
    last=$(sed -n 's/^last: //p' "$FEEDPROC")
    case "$last" in
        *unchanged)
            rm -f "$stage" "$stage.sig"
            echo "hunterctl: $name: already up to date"
            return 0 ;;
    esac
    if [ "$how" = install ]; then
        mkdir -p "$HISTORY/$name" || die "cannot create $HISTORY/$name"
        cp "$stage" "$HISTORY/$name/$ver"
        if [ -f "$stage.sig" ]; then cp "$stage.sig" "$HISTORY/$name/$ver.sig"; else rm -f "$HISTORY/$name/$ver.sig"; fi
        versions "$name" | awk -v k="$KEEP" '{ v[NR] = $1 } END { for (i = 1; i <= NR - k; i++) print v[i] }' \
            | while read -r old; do rm -f "$HISTORY/$name/$old" "$HISTORY/$name/$old.sig"; done
    else
        ver=$4
    fi
    # Signature first, feed second, each renamed into place: a reboot in
    # between finds a pair that does not match and refuses that one feed --
    # loud, and fixed by the next update -- never a feed that was not checked.
    if [ -f "$stage.sig" ]; then
        mv "$stage.sig" "$SIGDIR/$name.sig"
    else
        rm -f "$SIGDIR/$name.sig"
    fi
    mv "$stage" "$SIGDIR/$name"
    echo "$ver" > "$HISTORY/$name/current"
    echo "hunterctl: $last"
}

# One pass of hunterd: everything new in the event ring goes to the end of
# events.log, and every program the kernel has learned ends up in the
# learned file it reads back at the next boot.
#
# The ring is read through /proc/hunter, which shows what is still in it. Each
# event carries a sequence number that only grows within a boot, so the cursor
# file remembers the boot it was taken in and the next number to write; a
# different boot_id means a reboot, and numbering starts again at 0. An event
# the ring evicted before this pass could read it is not lost silently: the
# gap is written down as a LOST line with the numbers that are missing.
#
# Events keep the kernel's time (seconds since boot) and get a wall-clock UTC
# time worked out from the uptime, so the history reads across reboots. Lines
# are tab-separated, one event each:
#
#   time  boot  seq  uptime  pid  severity  category  action  description
#
# boot is the first 8 characters of the boot_id; a BOOT line opens each boot.
persist() {
    mkdir -p "$LOGDIR" "$STATEDIR" || return 1
    chmod 750 "$LOGDIR" 2>/dev/null
    chmod 700 "$STATEDIR" 2>/dev/null
    snap=$(mktemp) || return 1
    if ! cat "$PROC" > "$snap" 2>/dev/null; then
        rm -f "$snap"
        return 1
    fi
    boot=$(cat "$R/proc/sys/kernel/random/boot_id" 2>/dev/null)
    [ -n "$boot" ] || boot=unknown
    up=$(cut -d' ' -f1 "$R/proc/uptime" 2>/dev/null)
    [ -n "$up" ] || up=0
    now=${HUNTERCTL_NOW:-$(date +%s)}
    # Not `read < "$CURSOR"`: in busybox ash, the first `read` after a
    # `wait` that a signal cut short spins on EINTR, and that is exactly the
    # daemon's last pass at shutdown.
    cur=$(cat "$CURSOR" 2>/dev/null)
    cboot=${cur% *}
    from=${cur##* }
    fresh=0
    if [ "$cboot" != "$boot" ]; then
        fresh=1
        from=0
    fi
    case "$from" in ''|*[!0-9]*) from=0 ;; esac
    (
        umask 027
        awk -v boot="$boot" -v up="$up" -v now="$now" -v from="$from" \
            -v fresh="$fresh" -v cur="$CURSOR.new" "$PERSIST_AWK" "$snap" >> "$EVENTS"
    ) && mv -f "$CURSOR.new" "$CURSOR"
    rotate_events

    # The learned set only grows here: a line taken out of the file would
    # come straight back while the kernel still trusts the program. To stop
    # trusting one, deny it; the kernel does not restore a denied program.
    sed -n '/^learned-programs/,/^$/{/^  /s/^  //p}' "$snap" > "$snap.l"
    if [ -s "$snap.l" ]; then
        { [ -f "$LEARNED" ] && grep -v '^#' "$LEARNED"; cat "$snap.l"; } | sort -u > "$snap.u"
        if ! { [ -f "$LEARNED" ] && grep -v '^#' "$LEARNED" | cmp -s - "$snap.u"; }; then
            (
                umask 077
                {
                    echo "# Programs hunter learned (trust on first use), kept by hunterd."
                    echo "# Read back by the kernel at boot. To distrust one: hunterctl deny."
                    cat "$snap.u"
                } > "$LEARNED.new"
            ) && mv -f "$LEARNED.new" "$LEARNED"
        fi
    fi
    rm -f "$snap" "$snap.l" "$snap.u"
}

# The awk half of persist(): the ring's lines in, events.log's lines out.
PERSIST_AWK='
# Seconds since 1970 as an ISO 8601 UTC time, without strftime (busybox awk
# has it, mawk on a build host may not). The civil-from-days algorithm (H. Hinnant).
function iso(t,    d, s, z, era, doe, yoe, y, doy, mp, dd, mm) {
    t = int(t); d = int(t / 86400); s = t - d * 86400
    z = d + 719468; era = int(z / 146097); doe = z - era * 146097
    yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
    y = yoe + era * 400; doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100))
    mp = int((5 * doy + 2) / 153); dd = doy - int((153 * mp + 2) / 5) + 1
    mm = mp < 10 ? mp + 3 : mp - 9
    if (mm <= 2) y++
    return sprintf("%04d-%02d-%02dT%02d:%02d:%02dZ", y, mm, dd, int(s / 3600), int(s % 3600 / 60), s % 60)
}
function line(ts, seq, pid, sev, cat, act, desc) {
    gsub(/[\t\r]/, " ", desc)
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", iso(t0 + ts), short, seq, ts, pid, sev, cat, act, desc
}
BEGIN {
    t0 = now - up; short = substr(boot, 1, 8); expect = from + 0
    if (fresh == 1) line(0, "-", 0, "INFO", "HUNTERD", "BOOT", "boot " boot)
}
/^\[ *[0-9]+\] \+ *[0-9]+\.[0-9]+s pid=[0-9]+ / {
    r = $0
    sub(/^\[ */, "", r)
    seq = r; sub(/\].*$/, "", seq); seq += 0
    if (seq < expect) next
    sub(/^[0-9]+\] \+ */, "", r)
    ts = r; sub(/s .*$/, "", ts)
    sub(/^[0-9.]+s pid=/, "", r)
    pid = r; sub(/ .*$/, "", pid)
    sub(/^[0-9]+ +/, "", r)
    sev = r; sub(/ .*$/, "", sev); sub(/^[^ ]+ +/, "", r)
    cat = r; sub(/ .*$/, "", cat); sub(/^[^ ]+ +/, "", r)
    act = r; sub(/:.*$/, "", act)
    desc = r; sub(/^[^:]*: ?/, "", desc)
    if (seq > expect)
        line(ts, "-", 0, "WARN", "HUNTERD", "LOST",                   \
             "events " expect ".." (seq - 1) " left the ring before hunterd read them")
    line(ts, seq, pid, sev, cat, act, desc)
    expect = seq + 1
