        } | tee "$MEDIA_REPORTS/$id"
        if [ "$infected" -gt 0 ]; then
            # Not moved into the quarantine: the files are on somebody's
            # stick, and pulling it out halfway through would lose them. Denied
            # instead, so none of them runs (until reboot) even with the
            # antivirus only reporting; `hunterctl quarantine` is a step away.
            # One line at a time: a path with a space in it is not a `deny`
            # hunter takes, and it must not take the rest of them down with it.
            sed -n 's/: [^ ]* FOUND$//p' "$out" | while IFS= read -r f; do
                printf 'deny %s\n' "$f" > "$deny"
                dd if="$deny" of="$PROC" bs=1048576 count=1 2>/dev/null ||
                    echo "hunterctl: could not deny $f" >&2
            done
            dirty=1
        fi
        send "media $id done $total $infected"
    done
    [ "$dirty" -eq 0 ]
    ;;
quarantine)
    [ $# -ge 1 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    mkdir -p "$QDIR" && chmod 700 "$QDIR" || die "cannot create $QDIR"
    for f in "$@"; do
        real=$(readlink -f -- "$f") || die "cannot resolve $f"
        [ -f "$real" ] || die "not a file: $f"
        sum=$(sha256sum -- "$real" | cut -d' ' -f1)
        mode=$(stat -c %a -- "$real")
        mv -- "$real" "$QDIR/$sum" || die "cannot move $real"
        chmod 000 "$QDIR/$sum"
        printf '%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$sum" "$mode" "$real" >> "$QDIR/index"
