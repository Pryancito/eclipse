#!/bin/sh
# hunterctl — operator front end for hunter, Eclipse OS's in-kernel security
# subsystem.
#
# Everything it changes goes through one door: a write to /proc/hunter, in
# hunter's control language (see docs/hunter-security.md). The kernel checks
# that the writer is root and applies each write all or nothing, so this
# script holds no policy of its own -- it only spells the directives.
#
#   hunterctl [status]              modes, counters, lists (no event ring)
#   hunterctl events                the full report, event ring included
#   hunterctl mode <domain> <mode>  domain: syscall|wx|exec|anomaly|integrity|av
#                                   mode:   off|report|enforce
#   hunterctl learning <on|off>
#   hunterctl anomaly-detection <on|off>
#   hunterctl privileged-deny <on|off>
#   hunterctl trust <path|dir/>     add to the exec allowlist
#   hunterctl deny <path|dir/>      add to the exec blacklist
#   hunterctl untrusted <dir/>      add a world-writable location
#   hunterctl seal                  one-way: from now on, only tighten
#   hunterctl apply <file>          send a whole policy script (e.g. policy.conf)
#   hunterctl hash <file>...        pin the SHA-256 of programs (live + /etc/hunter/hashes)
#   hunterctl require-hash <on|off> unpinned programs are integrity violations
#   hunterctl verify                check the files on disk against /etc/hunter/hashes
#   hunterctl scan [--quarantine] <path>...
#                                   antivirus scan of files/trees (exit 1 if infected)
#   hunterctl quarantine <file>...  move files into the quarantine and deny their paths
#   hunterctl quarantined           list the quarantine
#   hunterctl restore <sha256>      put a quarantined file back where it was
#   hunterctl update-signatures     download the feeds in /etc/hunter/feeds
#   hunterctl lockdown              enforce exec + integrity + av, learning off, seal
#   hunterctl save-learned          append learned programs to the whitelist
#   hunterctl daemon [seconds]      hunterd: keep events and learned programs on disk
#   hunterctl persist               one pass of the daemon, now
#   hunterctl history [--alerts|--critical] [--this-boot] [N]
#                                   the last N events kept on disk (default 50, 0 = all)

# HUNTERCTL_ROOT puts every path below under another directory, which is how
# the tests drive the daemon against a fake /proc on the build host.
R=${HUNTERCTL_ROOT:-}
PROC=$R/proc/hunter
WHITELIST=/etc/hunter/whitelist
HASHES=/etc/hunter/hashes
SCAN=/proc/hunter_scan
QDIR=/var/lib/hunter/quarantine
FEEDS=/etc/hunter/feeds
SIGDIR=/etc/hunter/signatures.d
# Paths per write to /proc/hunter_scan: each batch is scanned before the
# write returns, and 256 paths stay well under the 1 MiB a write may carry.
BATCH=256
TAB=$(printf '\t')
# hunterd's files. The event history is a log (and readable by the adm
# group, like the rest of /var/log); the learned set and the cursor are
# state, and the learned set is something the kernel trusts at boot, so only
# root may read or write any of it.
LOGDIR=$R/var/log/hunter
EVENTS=$LOGDIR/events.log
STATEDIR=$R/var/lib/hunter
LEARNED=$STATEDIR/learned
CURSOR=$STATEDIR/events.cursor
# events.log is rotated past LOG_MAX bytes into events.log.1 .. .LOG_KEEP, so
# the history costs at most (LOG_KEEP + 1) * LOG_MAX of disk: 5 MiB.
LOG_MAX=${HUNTERD_LOG_MAX:-1048576}
LOG_KEEP=4

die() {
    echo "hunterctl: $*" >&2
    exit 1
}

usage() {
    sed -n '/^#   hunterctl \[status\]/,/^#  *the last N events/p' "$0" | sed 's/^#//'
    exit "${1:-0}"
}

# One write(2) per script: the kernel takes each write as a whole script, all
# or nothing. The script goes through a regular file and a single dd block
# larger than anything hunter accepts, because printf through stdio, or dd
# reading a pipe, could hand a long script over in two pieces -- and two
# halves are two different scripts.
send() {
    [ "$(id -u)" = 0 ] || die "must be root"
    msg=$(mktemp) || die "mktemp failed"
    printf '%s\n' "$1" > "$msg"
    if dd if="$msg" of="$PROC" bs=1048576 count=1 2>/dev/null; then
        rm -f "$msg"
    else
        rm -f "$msg"
        die "hunter rejected the script; nothing was applied (see '$0 events')"
    fi
}

# One pass of hunterd: everything new in the event ring goes to the end of
# events.log, and every program the kernel has learned ends up in the
# learned file it reads back at the next boot.
#
# The ring is read through /proc/hunter, which shows what is still in it. Each
# event carries a sequence number that only grows within a boot, so the cursor
# file remembers the boot it was taken in and the next number to write; a
# different boot_id means a reboot, and numbering starts again at 0. An event
# the ring evicted before this pass could read it is not lost silently: the
# gap is written down as a LOST line with the numbers that are missing.
#
# Events keep the kernel's time (seconds since boot) and get a wall-clock UTC
# time worked out from the uptime, so the history reads across reboots. Lines
# are tab-separated, one event each:
#
#   time  boot  seq  uptime  pid  severity  category  action  description
#
# boot is the first 8 characters of the boot_id; a BOOT line opens each boot.
persist() {
    mkdir -p "$LOGDIR" "$STATEDIR" || return 1
    chmod 750 "$LOGDIR" 2>/dev/null
    chmod 700 "$STATEDIR" 2>/dev/null
    snap=$(mktemp) || return 1
    if ! cat "$PROC" > "$snap" 2>/dev/null; then
        rm -f "$snap"
        return 1
    fi
    boot=$(cat "$R/proc/sys/kernel/random/boot_id" 2>/dev/null)
    [ -n "$boot" ] || boot=unknown
    up=$(cut -d' ' -f1 "$R/proc/uptime" 2>/dev/null)
    [ -n "$up" ] || up=0
    now=${HUNTERCTL_NOW:-$(date +%s)}
    # Not `read < "$CURSOR"`: in busybox ash, the first `read` after a
    # `wait` that a signal cut short spins on EINTR, and that is exactly the
    # daemon's last pass at shutdown.
    cur=$(cat "$CURSOR" 2>/dev/null)
    cboot=${cur% *}
    from=${cur##* }
    fresh=0
    if [ "$cboot" != "$boot" ]; then
        fresh=1
        from=0
    fi
    case "$from" in ''|*[!0-9]*) from=0 ;; esac
    (
        umask 027
        awk -v boot="$boot" -v up="$up" -v now="$now" -v from="$from" \
            -v fresh="$fresh" -v cur="$CURSOR.new" "$PERSIST_AWK" "$snap" >> "$EVENTS"
    ) && mv -f "$CURSOR.new" "$CURSOR"
    rotate_events

    # The learned set only grows here: a line taken out of the file would
    # come straight back while the kernel still trusts the program. To stop
    # trusting one, deny it; the kernel does not restore a denied program.
    sed -n '/^learned-programs/,/^$/{/^  /s/^  //p}' "$snap" > "$snap.l"
    if [ -s "$snap.l" ]; then
        { [ -f "$LEARNED" ] && grep -v '^#' "$LEARNED"; cat "$snap.l"; } | sort -u > "$snap.u"
        if ! { [ -f "$LEARNED" ] && grep -v '^#' "$LEARNED" | cmp -s - "$snap.u"; }; then
            (
                umask 077
                {
                    echo "# Programs hunter learned (trust on first use), kept by hunterd."
                    echo "# Read back by the kernel at boot. To distrust one: hunterctl deny."
                    cat "$snap.u"
                } > "$LEARNED.new"
            ) && mv -f "$LEARNED.new" "$LEARNED"
        fi
    fi
    rm -f "$snap" "$snap.l" "$snap.u"
}

# The awk half of persist(): the ring's lines in, events.log's lines out.
PERSIST_AWK='
# Seconds since 1970 as an ISO 8601 UTC time, without strftime (busybox awk
# has it, mawk on a build host may not). The civil-from-days algorithm (H. Hinnant).
function iso(t,    d, s, z, era, doe, yoe, y, doy, mp, dd, mm) {
    t = int(t); d = int(t / 86400); s = t - d * 86400
    z = d + 719468; era = int(z / 146097); doe = z - era * 146097
    yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
    y = yoe + era * 400; doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100))
    mp = int((5 * doy + 2) / 153); dd = doy - int((153 * mp + 2) / 5) + 1
    mm = mp < 10 ? mp + 3 : mp - 9
    if (mm <= 2) y++
    return sprintf("%04d-%02d-%02dT%02d:%02d:%02dZ", y, mm, dd, int(s / 3600), int(s % 3600 / 60), s % 60)
}
function line(ts, seq, pid, sev, cat, act, desc) {
    gsub(/[\t\r]/, " ", desc)
    printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", iso(t0 + ts), short, seq, ts, pid, sev, cat, act, desc
}
BEGIN {
    t0 = now - up; short = substr(boot, 1, 8); expect = from + 0
    if (fresh == 1) line(0, "-", 0, "INFO", "HUNTERD", "BOOT", "boot " boot)
}
/^\[ *[0-9]+\] \+ *[0-9]+\.[0-9]+s pid=[0-9]+ / {
    r = $0
    sub(/^\[ */, "", r)
    seq = r; sub(/\].*$/, "", seq); seq += 0
    if (seq < expect) next
    sub(/^[0-9]+\] \+ */, "", r)
    ts = r; sub(/s .*$/, "", ts)
    sub(/^[0-9.]+s pid=/, "", r)
    pid = r; sub(/ .*$/, "", pid)
    sub(/^[0-9]+ +/, "", r)
    sev = r; sub(/ .*$/, "", sev); sub(/^[^ ]+ +/, "", r)
    cat = r; sub(/ .*$/, "", cat); sub(/^[^ ]+ +/, "", r)
    act = r; sub(/:.*$/, "", act)
    desc = r; sub(/^[^:]*: ?/, "", desc)
    if (seq > expect)
        line(ts, "-", 0, "WARN", "HUNTERD", "LOST",                   \
             "events " expect ".." (seq - 1) " left the ring before hunterd read them")
    line(ts, seq, pid, sev, cat, act, desc)
    expect = seq + 1
}
END { print boot, expect > cur }
'

rotate_events() {
    size=$(wc -c < "$EVENTS" 2>/dev/null) || return 0
    [ "${size:-0}" -gt "$LOG_MAX" ] || return 0
    i=$LOG_KEEP
    while [ "$i" -gt 1 ]; do
        [ -f "$EVENTS.$((i - 1))" ] && mv -f "$EVENTS.$((i - 1))" "$EVENTS.$i"
        i=$((i - 1))
    done
    mv -f "$EVENTS" "$EVENTS.1"
}

cmd=${1:-status}
[ $# -gt 0 ] && shift

case "$cmd" in
-h|--help|help) usage 0 ;;
history)
    # Reads only the disk, so it also works on a kernel without hunter, or
    # to look at what happened before the last reboot.
    sev='.'
    boot=
    n=50
    for a in "$@"; do
        case "$a" in
        --alerts) sev='^(WARN|CRIT)$' ;;
        --critical) sev='^CRIT$' ;;
        --this-boot) boot=$(cut -c1-8 "$R/proc/sys/kernel/random/boot_id" 2>/dev/null) ;;
        *[!0-9]*|'') usage 1 ;;
        *) n=$a ;;
        esac
    done
    files=
    i=$LOG_KEEP
    while [ "$i" -ge 1 ]; do
        [ -r "$EVENTS.$i" ] && files="$files $EVENTS.$i"
        i=$((i - 1))
    done
    [ -r "$EVENTS" ] && files="$files $EVENTS"
    [ -n "$files" ] || { echo "hunterctl: no history yet in $LOGDIR"; exit 0; }
    # shellcheck disable=SC2086
    cat $files | awk -F '\t' -v sev="$sev" -v boot="$boot" '
        NF >= 9 && $6 ~ sev && (boot == "" || $2 == boot) {
            printf "%s %s %-6s %-9s %s: %s", $1, $2, $6, $7, $8, $9
            if ($5 != 0) printf " (pid %s)", $5
            printf "\n"
        }' | if [ "$n" = 0 ]; then cat; else tail -n "$n"; fi
    exit 0
    ;;
esac

[ -r "$PROC" ] || die "$PROC not found: is this an Eclipse OS kernel with hunter?"

case "$cmd" in
status)
    sed '/^recent events/,$d' "$PROC"
    ;;
events)
    cat "$PROC"
    ;;
mode)
    [ $# -eq 2 ] || usage 1
    send "mode $1 $2"
    ;;
learning|anomaly-detection|privileged-deny|require-hash|trust|deny|untrusted)
    [ $# -eq 1 ] || usage 1
    send "$cmd $1"
    ;;
seal)
    send "seal"
    ;;
apply)
    [ $# -eq 1 ] || usage 1
    [ -r "$1" ] || die "cannot read $1"
    send "$(cat "$1")"
    ;;
hash)
    [ $# -ge 1 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    # Pinned by the file's real path: the kernel checks a program by its name
    # AND by the path it resolves to, so pinning the target covers every link
    # to it. One script for all of them, so the batch is all or nothing too.
    script=""
    mkdir -p "${HASHES%/*}"
    touch "$HASHES"
    tmp=$(mktemp) || die "mktemp failed"
    trap 'rm -f "$tmp" "$tmp.new"' EXIT
    cp "$HASHES" "$tmp"
    for f in "$@"; do
        real=$(readlink -f -- "$f") || die "cannot resolve $f"
        [ -f "$real" ] || die "not a file: $f"
        sum=$(sha256sum -- "$real" | cut -d' ' -f1) || die "cannot hash $real"
        # Replace an earlier pin of the same file rather than stacking a
        # second, stale line under it.
        # (A sha256sum line is 64 hex digits, two spaces, then the path.)
        awk -v p="$real" 'substr($0, 67) != p' "$tmp" > "$tmp.new"
        printf '%s  %s\n' "$sum" "$real" >> "$tmp.new"
        mv "$tmp.new" "$tmp"
        script="${script}hash $sum  $real
"
    done
    send "$script"
    mv "$tmp" "$HASHES"
    echo "hunterctl: pinned $# program(s); $(grep -c . "$HASHES") in $HASHES"
    ;;
verify)
    [ -r "$HASHES" ] || die "no $HASHES"
    sha256sum -c "$HASHES"
    ;;
lockdown)
    # Exec and integrity. W^X stays where it is because enforcing it breaks
    # every JIT (Firefox, any JS engine), and the anomaly heuristics cost a
    # lock on every syscall; both are a deliberate `mode` away. Whatever was
    # learned or pinned so far stays trusted, so run save-learned (and hash)
    # first. After this an updated binary whose pin no longer matches will
    # not run until reboot: re-pinning is a relaxation, and the seal refuses
    # it.
    send "mode exec enforce
mode integrity enforce
mode av enforce
learning off
seal"
    ;;
scan)
    [ "$(id -u)" = 0 ] || die "must be root"
    quarantine=0
    if [ "${1:-}" = "--quarantine" ]; then
        quarantine=1
        shift
    fi
    [ $# -ge 1 ] || usage 1
    [ -w "$SCAN" ] || die "$SCAN not found: this kernel's hunter has no antivirus"
    list=$(mktemp) && out=$(mktemp) && batch=$(mktemp) || die "mktemp failed"
    trap 'rm -f "$list" "$out" "$batch"' EXIT
    find "$@" -type f > "$list" 2>/dev/null
    total=$(wc -l < "$list")
    i=1
    while [ "$i" -le "$total" ]; do
        sed -n "${i},$((i + BATCH - 1))p" "$list" > "$batch"
        dd if="$batch" of="$SCAN" bs=1048576 count=1 2>/dev/null || die "scan write failed"
        cat "$SCAN" >> "$out"
        i=$((i + BATCH))
    done
    grep -E ' FOUND$|: ERROR ' "$out"
    infected=$(grep -c ' FOUND$' "$out")
    echo "hunterctl: scanned $total file(s), $infected infected"
    if [ "$infected" -gt 0 ] && [ "$quarantine" = 1 ]; then
        sed -n 's/: [^ ]* FOUND$//p' "$out" | while IFS= read -r f; do
            "$0" quarantine "$f"
        done
    fi
    [ "$infected" -eq 0 ]
    ;;
quarantine)
    [ $# -ge 1 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    mkdir -p "$QDIR" && chmod 700 "$QDIR" || die "cannot create $QDIR"
    for f in "$@"; do
        real=$(readlink -f -- "$f") || die "cannot resolve $f"
        [ -f "$real" ] || die "not a file: $f"
        sum=$(sha256sum -- "$real" | cut -d' ' -f1)
        mode=$(stat -c %a -- "$real")
        mv -- "$real" "$QDIR/$sum" || die "cannot move $real"
        chmod 000 "$QDIR/$sum"
        printf '%s\t%s\t%s\t%s\n' "$(date +%Y-%m-%dT%H:%M:%S)" "$sum" "$mode" "$real" >> "$QDIR/index"
        # A copy dropped at the same path again must not run either. The
        # blacklist lasts until reboot (hunter never forgets a deny).
        send "deny $real"
        echo "hunterctl: quarantined $real ($sum)"
    done
    ;;
quarantined)
    [ -r "$QDIR/index" ] || { echo "hunterctl: quarantine is empty"; exit 0; }
    cat "$QDIR/index"
    ;;
restore)
    [ $# -eq 1 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    line=$(grep -F "$TAB$1$TAB" "$QDIR/index" 2>/dev/null | tail -n 1)
    [ -n "$line" ] && [ -e "$QDIR/$1" ] || die "no quarantined file $1"
    mode=$(printf '%s\n' "$line" | cut -f3)
    dest=$(printf '%s\n' "$line" | cut -f4-)
    [ -e "$dest" ] && die "$dest exists; not overwriting it"
    mv -- "$QDIR/$1" "$dest" && chmod "$mode" "$dest" || die "cannot restore to $dest"
    grep -vF "$TAB$1$TAB" "$QDIR/index" > "$QDIR/index.new"; mv "$QDIR/index.new" "$QDIR/index"
    echo "hunterctl: restored $dest (its path stays denied until reboot)"
    ;;
update-signatures)
    [ "$(id -u)" = 0 ] || die "must be root"
    [ -r "$FEEDS" ] || die "no $FEEDS"
    mkdir -p "$SIGDIR"
    raw=$(mktemp) && sigs=$(mktemp) && part=$(mktemp) || die "mktemp failed"
    trap 'rm -f "$raw" "$sigs" "$part"' EXIT
    # `<format> <name> <url>`: format `sigs` is hunter's own signature lines,
    # `sha256` a list with one SHA-256 per line (first field), as abuse.ch's
    # MalwareBazaar exports are.
    grep -v '^[[:space:]]*\(#\|$\)' "$FEEDS" | while read -r format name url; do
        case "$name" in
            ''|*/*|.*) echo "hunterctl: bad feed name '$name'" >&2; continue ;;
        esac
        if command -v curl >/dev/null 2>&1; then
            curl -fsSL --max-time 300 -o "$raw" "$url"
        else
            wget -q -T 300 -O "$raw" "$url"
        fi || { echo "hunterctl: $name: download failed: $url" >&2; continue; }
        case "$format" in
            sigs)
                grep -E '^(hash|bytes):' "$raw" > "$sigs" ;;
            sha256)
                awk -v n="$name" '!/^#/ && length($1) == 64 && $1 ~ /^[0-9a-fA-F]+$/ { print "hash:" tolower($1) ":" n }' "$raw" > "$sigs" ;;
            *)
                echo "hunterctl: $name: unknown feed format '$format'" >&2; continue ;;
        esac
        count=$(wc -l < "$sigs")
        # An empty or broken download must not replace a feed that worked.
        if [ "$count" -eq 0 ]; then
            echo "hunterctl: $name: no signatures in the download; keeping the old feed" >&2
            continue
        fi
        # Live, in batches the kernel takes whole: a batch with a line it
        # cannot parse is refused entirely, and the feed is not installed.
        ok=1
        total=$count
        i=1
        while [ "$i" -le "$total" ]; do
            sed -n "${i},$((i + 4999))p" "$sigs" | sed 's/^/signature /' > "$part"
            dd if="$part" of="$PROC" bs=4194304 count=1 2>/dev/null || { ok=0; break; }
            i=$((i + 5000))
        done
        if [ "$ok" = 1 ]; then
            # Into a dot-file first (the kernel skips those), then renamed:
            # a reboot halfway through finds the old feed or the new one.
            cp "$sigs" "$SIGDIR/.$name.new" && mv "$SIGDIR/.$name.new" "$SIGDIR/$name"
            echo "hunterctl: $name: $count signature(s)"
        else
            echo "hunterctl: $name: hunter rejected the feed; not installed" >&2
        fi
    done
    ;;
daemon)
    # hunterd. eclipse-init starts it (as /usr/local/bin/eclipse-hunterd) and
    # restarts it if it dies; the cursor on disk makes a restart pick up
    # where the last pass stopped. TERM (shutdown) gets one last pass.
    [ "$(id -u)" = 0 ] || [ -n "$R" ] || die "must be root"
    interval=${1:-5}
    case "$interval" in ''|*[!0-9]*|0) usage 1 ;; esac
    # The trap only raises a flag, and the loop makes the last pass.
    stop=0
    trap 'stop=1' TERM INT HUP
    while [ "$stop" = 0 ]; do
        persist || echo "hunterctl: could not save hunter's state" >&2
        [ "$stop" = 0 ] || break
        # In the background and waited for, so a TERM ends the wait now and
        # not when the sleep does.
        sleep "$interval" &
        wait $!
    done
    kill $! 2>/dev/null
    persist
    ;;
persist)
    [ "$(id -u)" = 0 ] || [ -n "$R" ] || die "must be root"
    persist || die "could not save hunter's state"
    ;;
save-learned)
    [ "$(id -u)" = 0 ] || die "must be root"
    mkdir -p "${WHITELIST%/*}"
    touch "$WHITELIST"
    tmp=$(mktemp) || die "mktemp failed"
    sed -n '/^learned-programs/,/^$/{/^  /s/^  //p}' "$PROC" > "$tmp"
    added=0
    while IFS= read -r p; do
        if ! grep -qxF -- "$p" "$WHITELIST"; then
            printf '%s\n' "$p" >> "$WHITELIST"
            added=$((added + 1))
        fi
    done < "$tmp"
    rm -f "$tmp"
    echo "hunterctl: $added program(s) added to $WHITELIST"
    ;;
*)
    usage 1
    ;;
esac
