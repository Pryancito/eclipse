    for id in $ids; do
        target=$(target_of "$id")
        [ -n "$target" ] || die "no media #$id"
        send "media $id scanning"
        : > "$out"
        # -xdev: a disk mounted inside the stick is its own device, with its
        # own line and its own scan.
        find "$target" -xdev -type f > "$list" 2>/dev/null
        total=$(wc -l < "$list")
        ok=1
        i=1
        while [ "$i" -le "$total" ]; do
            sed -n "${i},$((i + BATCH - 1))p" "$list" > "$batch"
            dd if="$batch" of="$SCAN" bs=1048576 count=1 2>/dev/null || { ok=0; break; }
            cat "$SCAN" >> "$out"
            i=$((i + BATCH))
        done
        if [ "$ok" = 0 ]; then
            send "media $id failed"
            echo "hunterctl: media #$id ($target): scan failed" | tee "$MEDIA_REPORTS/$id"
            dirty=1
            continue
        fi
        infected=$(grep -c ' FOUND$' "$out")
        { grep -E ' FOUND$|: ERROR ' "$out"
