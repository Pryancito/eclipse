#!/bin/sh
# hunterctl — operator front end for hunter, Eclipse OS's in-kernel security
# subsystem.
#
# Everything it changes goes through one door: a write to /proc/hunter, in
# hunter's control language (see docs/hunter-security.md). The kernel checks
# that the writer is root and applies each write all or nothing, so this
# script holds no policy of its own -- it only spells the directives.
#
#   hunterctl [status]              modes, counters, lists (no event ring)
#   hunterctl events                the full report, event ring included
#   hunterctl mode <domain> <mode>  domain: syscall|wx|exec|anomaly|integrity
#                                   mode:   off|report|enforce
#   hunterctl learning <on|off>
#   hunterctl anomaly-detection <on|off>
#   hunterctl privileged-deny <on|off>
#   hunterctl trust <path|dir/>     add to the exec allowlist
#   hunterctl deny <path|dir/>      add to the exec blacklist
#   hunterctl untrusted <dir/>      add a world-writable location
#   hunterctl seal                  one-way: from now on, only tighten
#   hunterctl apply <file>          send a whole policy script (e.g. policy.conf)
#   hunterctl hash <file>...        pin the SHA-256 of programs (live + /etc/hunter/hashes)
#   hunterctl require-hash <on|off> unpinned programs are integrity violations
#   hunterctl verify                check the files on disk against /etc/hunter/hashes
#   hunterctl lockdown              enforce exec + integrity, learning off, seal
#   hunterctl save-learned          append learned programs to the whitelist

PROC=/proc/hunter
WHITELIST=/etc/hunter/whitelist
HASHES=/etc/hunter/hashes

die() {
    echo "hunterctl: $*" >&2
    exit 1
}

usage() {
    sed -n '/^#   hunterctl \[status\]/,/^#   hunterctl save-learned/p' "$0" | sed 's/^#//'
    exit "${1:-0}"
}

# One write(2) per script: the kernel takes each write as a whole script, all
# or nothing. The script goes through a regular file and a single dd block
# larger than anything hunter accepts, because printf through stdio, or dd
# reading a pipe, could hand a long script over in two pieces -- and two
# halves are two different scripts.
send() {
    [ "$(id -u)" = 0 ] || die "must be root"
    msg=$(mktemp) || die "mktemp failed"
    printf '%s\n' "$1" > "$msg"
    if dd if="$msg" of="$PROC" bs=1048576 count=1 2>/dev/null; then
        rm -f "$msg"
    else
        rm -f "$msg"
        die "hunter rejected the script; nothing was applied (see '$0 events')"
    fi
}

cmd=${1:-status}
[ $# -gt 0 ] && shift

case "$cmd" in
-h|--help|help) usage 0 ;;
esac

[ -r "$PROC" ] || die "$PROC not found: is this an Eclipse OS kernel with hunter?"

case "$cmd" in
status)
    sed '/^recent events/,$d' "$PROC"
    ;;
events)
    cat "$PROC"
    ;;
mode)
    [ $# -eq 2 ] || usage 1
    send "mode $1 $2"
    ;;
learning|anomaly-detection|privileged-deny|require-hash|trust|deny|untrusted)
    [ $# -eq 1 ] || usage 1
    send "$cmd $1"
    ;;
seal)
    send "seal"
    ;;
apply)
    [ $# -eq 1 ] || usage 1
    [ -r "$1" ] || die "cannot read $1"
    send "$(cat "$1")"
    ;;
hash)
    [ $# -ge 1 ] || usage 1
    [ "$(id -u)" = 0 ] || die "must be root"
    # Pinned by the file's real path: the kernel checks a program by its name
    # AND by the path it resolves to, so pinning the target covers every link
    # to it. One script for all of them, so the batch is all or nothing too.
    script=""
    mkdir -p "${HASHES%/*}"
    touch "$HASHES"
    tmp=$(mktemp) || die "mktemp failed"
    trap 'rm -f "$tmp" "$tmp.new"' EXIT
    cp "$HASHES" "$tmp"
    for f in "$@"; do
        real=$(readlink -f -- "$f") || die "cannot resolve $f"
        [ -f "$real" ] || die "not a file: $f"
        sum=$(sha256sum -- "$real" | cut -d' ' -f1) || die "cannot hash $real"
        # Replace an earlier pin of the same file rather than stacking a
        # second, stale line under it.
        # (A sha256sum line is 64 hex digits, two spaces, then the path.)
        awk -v p="$real" 'substr($0, 67) != p' "$tmp" > "$tmp.new"
        printf '%s  %s\n' "$sum" "$real" >> "$tmp.new"
        mv "$tmp.new" "$tmp"
        script="${script}hash $sum  $real
"
    done
    send "$script"
    mv "$tmp" "$HASHES"
    echo "hunterctl: pinned $# program(s); $(grep -c . "$HASHES") in $HASHES"
    ;;
verify)
    [ -r "$HASHES" ] || die "no $HASHES"
    sha256sum -c "$HASHES"
    ;;
lockdown)
    # Exec and integrity. W^X stays where it is because enforcing it breaks
    # every JIT (Firefox, any JS engine), and the anomaly heuristics cost a
    # lock on every syscall; both are a deliberate `mode` away. Whatever was
    # learned or pinned so far stays trusted, so run save-learned (and hash)
    # first. After this an updated binary whose pin no longer matches will
    # not run until reboot: re-pinning is a relaxation, and the seal refuses
    # it.
    send "mode exec enforce
mode integrity enforce
learning off
seal"
    ;;
save-learned)
    [ "$(id -u)" = 0 ] || die "must be root"
    mkdir -p "${WHITELIST%/*}"
    touch "$WHITELIST"
    tmp=$(mktemp) || die "mktemp failed"
    sed -n '/^learned-programs/,/^$/{/^  /s/^  //p}' "$PROC" > "$tmp"
    added=0
    while IFS= read -r p; do
        if ! grep -qxF -- "$p" "$WHITELIST"; then
            printf '%s\n' "$p" >> "$WHITELIST"
            added=$((added + 1))
        fi
    done < "$tmp"
    rm -f "$tmp"
    echo "hunterctl: $added program(s) added to $WHITELIST"
    ;;
*)
    usage 1
    ;;
esac
